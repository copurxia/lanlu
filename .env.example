# 服务器配置 - 局域网访问
PORT=8082
HOST=0.0.0.0
NODE_ENV=development

# 数据库配置 - 使用完整的连接字符串
# 格式: <db_type>://<username>:<password>@<host>:<port>/<database>?sslmode=<ssl_mode>
# 示例: postgres://lgr:lgr@127.0.0.1:5432/lgr?sslmode=allow
# 本地开发/CI 烟雾测试：显式设置 DB_STRING 指向可用的 PG17 实例（替换部署凭据占位符），
# 例：DB_STRING=postgres://copur:<password>@192.168.0.112:5432/lanludev?sslmode=disable&pool.max=5
DB_STRING=postgres://lgr:lgr@127.0.0.1:5432/lgr?sslmode=allow

# 认证配置
JWT_SECRET=d2015833994569e3a4e3

# CORS配置 - 允许所有来源访问
CORS_ORIGIN=*

# 数据库连接池配置
# POOL_MAX/POOL_MIN/POOL_IDLE_TIMEOUT 经 connection_pool.buildConnStr 拼入 DB_STRING 的
# pool.max/pool.min/pool.idleTimeout 键；生产建议 POOL_MAX ≈ (CPU核数*2 + 磁盘数)，
# 并与 PG 服务端 max_connections 及 PgBouncer default_pool_size 三者对齐，避免排队打满。
POOL_MAX=10                    # 最大连接数
POOL_ACQUIRE_TIMEOUT=5000      # 获取连接超时 (ms)
POOL_IDLE_TIMEOUT=300000       # 空闲超时 (ms, 5分钟)
POOL_MAX_LIFETIME=1800000      # 连接最大生命周期 (ms, 30分钟)
POOL_KEEPALIVE=60000           # 健康检查间隔 (ms, 1分钟)

# statement_timeout（会话级慢查询保护，task-5）
# 连接串键 pool.statementTimeout（毫秒，0=不设置=默认，行为完全向后兼容）。
# driver 在每条连接建立后执行 SET statement_timeout='<ms>ms'；被取消的语句返回 SQLSTATE 57014。
# 部署建议：线上 30000~60000（30s~60s）防单个慢查询拖垮连接池；批处理/长迁移任务
# 用独立连接串放宽（如 300000）；PgBouncer transaction 模式下此键与会话绑定请改用
# PgBouncer 自身 server_idle_timeout/服务端 statement_timeout 配置。
# 示例：DB_STRING=postgres://lgr:lgr@127.0.0.1:5432/lgr?sslmode=allow&pool.statementTimeout=30000
# 相关键：pool.stmtCache（语句缓存，PgBouncer transaction 模式务必设 0）、pool.binaryResult。

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=simple
# 日志文件路径，留空则输出到 stdout；默认按大小滚动归档
LOG_FILE=./data/logs/system/system.log
# 单个日志文件超过此大小（MB）即滚动归档为 system-日期-序号.log，默认 10
LOG_MAX_SIZE_MB=10
