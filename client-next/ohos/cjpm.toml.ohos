[package]
cjc-version = "1.2.0"
name = "lanlu_client_next"
version = "0.1.0"
description = "lanlu client-next (OHOS engine build)"
output-type = "dynamic"

[dependencies]
cui = { path = "../../../packages/cangjie-gui" }
vips_ffi = { path = "../../../packages/vips_ffi" }
libvlc_ffi = { path = "../../../packages/libvlc_ffi" }
webview = { path = "../../../packages/webview" }
rocksdb_ffi = { path = "../../../packages/rocksdb_ffi" }
fontkit_ffi = { path = "../../../packages/fontkit_ffi" }
qwest = { path = "../../../packages/qwest" }
libavformat_ffi = { path = "../../../packages/libavformat_ffi" }
libass_ffi = { path = "../../../packages/libass_ffi" }
lwindow = { path = "../../../packages/lwindow" }
portcheck = { path = "../../../packages/portcheck" }

[package.metadata.ohos]
app-name = "ClientNext"
bundle-name = "com.example.cmakehap"
version-code = 1000000
api-level = 26
device-types = ["2in1", "phone"]
module-name = "entry"
shim-module = "lanlu_client_next"
entry-ability = "EntryAbility"
page = "pages/Index"
ui = "sdl3"

[target.aarch64-linux-ohos]
compile-option = "--sysroot=/workspace/horizon-ohos/.tooling/sdk26/clt/command-line-tools/sdk/default/openharmony/native/sysroot -B/workspace/horizon-ohos/.tooling/sdk26/clt/command-line-tools/sdk/default/openharmony/native/sysroot/usr/lib/aarch64-linux-ohos"
link-option = "-L /workspace/lanlu/.research-ohos/ohos-stubs -L /workspace/lanlu/.research-ohos/ohos-stubs/ffmpeg -L /workspace/lanlu/.research-ohos/sdl3-ohos/prefix-nov/lib -L /workspace/lanlu/.research-ohos/sdl3-ohos/prefix-single/lib -L /workspace/lanlu/lanlu/packages/webview/native/target/release -L /workspace/lanlu/lanlu/packages/rocksdb_ffi/native -L /workspace/lanlu/lanlu/packages/libavformat_ffi/native -L /workspace/lanlu/lanlu/packages/libass_ffi/native -L /workspace/lanlu/lanlu/packages/fontkit_ffi/native/target/release -L /workspace/horizon-ohos/.tooling/sdk26/clt/command-line-tools/sdk/default/openharmony/native/sysroot/usr/lib/aarch64-linux-ohos -lvips -lgio-2.0 -lgobject-2.0 -lglib-2.0 -lvlc -lrocksdb -lavformat -lavcodec -lavutil -llanlu_rocksdb_bridge -llanlu_avformat_bridge -llanlu_ass_bridge -l:libass.so.9 -lfontconfig -lfreetype -lfontkit_native -lwebview_native -lSDL3 -lSDL3_ttf -ldl -lpthread -lm"
  [target.aarch64-linux-ohos.bin-dependencies]
    path-option = [ "/workspace/.cjv/stdx/sts-1.2.0-linux-x64-ohos/static/stdx" ]
