diff --git a/src/core/lazy_column.cj b/src/core/lazy_column.cj
index 31708fd..2e603c1 100644
--- a/src/core/lazy_column.cj
+++ b/src/core/lazy_column.cj
@@ -136,6 +136,31 @@ public class LazyColumn <: Widget {
             let y = rect.y - frameScroll + Float32(index) * stride
             widget.layout(ctx, Rect(rect.x, y, contentWidth, itemHeight))
         }
+        revealFocusedInColumn(ctx, rect, content)
+    }
+
+    /*
+     * 焦点滚入视野（缺口 #8）：本列已构建的行里若有焦点控件跑出视口，把偏移拉到贴边。
+     * 只在焦点矩形落在本列内容纵向范围内时生效，避免与外层滚动容器互相拉扯。
+     */
+    private func revealFocusedInColumn(ctx: UiContext, rect: Rect, content: Float32): Unit {
+        match (ctx.focusedRect()) {
+            case Some(focus) =>
+                let top = focus.y - rect.y
+                let bottom = top + focus.h
+                if (top >= 0.0 && bottom <= rect.h) {
+                    return
+                }
+                // 内容坐标 = 当前滚动 + 视口内位置；行未构建时该矩形不存在，自然不会触发。
+                let target = scrollStateValue.value + top
+                let clamped = clampScrollOffset(target, content, rect.h)
+                if (clamped != scrollStateValue.value) {
+                    scrollStateValue.value = clamped
+                    scrollMotion.reset(clamped)
+                    ctx.requestFrame()
+                }
+            case None => ()
+        }
     }
 
     public func draw(ctx: UiContext): Unit {
diff --git a/src/core/lazy_reveal_test.cj b/src/core/lazy_reveal_test.cj
new file mode 100644
index 0000000..e629d40
--- /dev/null
+++ b/src/core/lazy_reveal_test.cj
@@ -0,0 +1,56 @@
+package cui.core
+
+import lgui.{Rect, Size, UiEvent}
+
+/* LazyColumn 焦点滚入视野（缺口 #8 的列表侧）。 */
+private class LazyFocusProbe <: Widget {
+    private let report: Rect
+
+    public init(report: Rect) {
+        this.report = report
+        emit(this)
+    }
+
+    public func measure(_: UiContext, _: Size): Size {
+        Size(100.0, 40.0)
+    }
+
+    public func layout(ctx: UiContext, _: Rect): Unit {
+        ctx.reportFocusRect("lazy.target", report)
+    }
+
+    public func draw(_: UiContext): Unit {}
+
+    public func handle(_: UiContext, _: UiEvent): Bool {
+        false
+    }
+}
+
+@Test
+func lazyColumnRevealsFocusedRow(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    // 焦点行在视口下方（y=200，视口 100 高）。
+    let probe = LazyFocusProbe(Rect(0.0, 200.0, 100.0, 40.0))
+    let column = LazyColumn(10, 40.0, scroll: offset, id: "lazy.reveal") {
+        _ => emit(probe)
+    }
+    ctx.focus("lazy.target", viaKeyboard: true)
+
+    column.layout(ctx, Rect(0.0, 0.0, 120.0, 100.0))
+    @Expect(offset.value > Float32(0.0)) // 已滚动以露出焦点行
+}
+
+@Test
+func lazyColumnLeavesVisibleFocusAlone(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let probe = LazyFocusProbe(Rect(0.0, 10.0, 100.0, 40.0))
+    let column = LazyColumn(10, 40.0, scroll: offset, id: "lazy.stay") {
+        _ => emit(probe)
+    }
+    ctx.focus("lazy.target", viaKeyboard: true)
+
+    column.layout(ctx, Rect(0.0, 0.0, 120.0, 100.0))
+    @Expect(offset.value, Float32(0.0))
+}
