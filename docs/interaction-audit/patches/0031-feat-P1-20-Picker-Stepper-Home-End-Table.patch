+package cui.controls
+
+import lgui.{Key, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+private func polishContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/* 缺口 #20 打磨：Picker/Stepper 的 Home/End 与 Table 的键盘排序。 */
+@Test
+func stepperHomeEndJumpToRangeBounds(): Unit {
+    let ctx = polishContext()
+    let value = State<Int64>(5)
+    let stepper = Stepper(value, key: "st.he", lower: 0, upper: 10, step: 1)
+    stepper.layout(ctx, Rect(0.0, 0.0, 100.0, 32.0))
+    ctx.focus("st.he", viaKeyboard: true)
+
+    @Expect(stepper.handle(ctx, UiEvent.KeyDown(Key.Home, false)))
+    @Expect(value.value, Int64(0))
+    @Expect(stepper.handle(ctx, UiEvent.KeyDown(Key.End, false)))
+    @Expect(value.value, Int64(10))
+}
+
+@Test
+func pickerHomeEndSelectFirstLast(): Unit {
+    let ctx = polishContext()
+    let selected = State<Int64>(1)
+    let picker = Picker(["甲", "乙", "丙"], selected, key: "pk.he")
+    picker.layout(ctx, Rect(0.0, 0.0, 100.0, 32.0))
+    ctx.focus("pk.he", viaKeyboard: true)
+
+    @Expect(picker.handle(ctx, UiEvent.KeyDown(Key.End, false)))
+    @Expect(selected.value, Int64(2))
+    @Expect(picker.handle(ctx, UiEvent.KeyDown(Key.Home, false)))
+    @Expect(selected.value, Int64(0))
+}
+
+@Test
+func tableKeyboardSortTogglesDirectionVisibleInSelection(): Unit {
+    let ctx = polishContext()
+    let columns = [TableColumn("名", 80.0), TableColumn("数", 80.0, numeric: true)]
+    let rows = [["b", "2"], ["a", "1"]]
+    let selected = State<Int64>(0)
+    let table = Table(columns, rows, selected, key: "tb.kb")
+    table.layout(ctx, Rect(0.0, 0.0, 200.0, 120.0))
+    ctx.focus("tb.kb", viaKeyboard: true)
+
+    // Shift+Right 换到数值列（升序显示序 = [a(1), b(2)]）；Home 把选中移到显示序第 0 行 = 原索引 1。
+    @Expect(table.handle(ctx, UiEvent.KeyDown(Key.Right, true)))
+    @Expect(table.handle(ctx, UiEvent.KeyDown(Key.Home, false)))
+    @Expect(selected.value, Int64(1))
+}
