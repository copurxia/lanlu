+    // 键盘排序入口：聚焦时 Shift+方向键把排序列左右移动，Enter/Space 翻转升降序。
+    private func shiftSortColumn(ctx: UiContext, delta: Int64): Bool {
+        if (!ctx.hasFocus(id) || columns.size == 0) {
+            return false
+        }
+        let next = (sortCol.value + delta + Int64(columns.size)) % Int64(columns.size)
+        sortCol.value = next
+        return true
+    }
+
+    private func toggleSortIfFocused(ctx: UiContext): Bool {
+        if (!ctx.hasFocus(id)) {
+            return false
+        }
+        toggleSort(sortCol.value)
+        return true
+    }
+
