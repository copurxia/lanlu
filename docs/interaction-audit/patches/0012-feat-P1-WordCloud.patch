         match (event) {
             case UiEvent.MouseDown(MouseButton.Left, x, y) => match (wordAt(x, y)) {
                 case Some(word) =>
+                    ctx.focus(id)
                     onClick(word.item);
                     true
                 case None => false
             }
+            // 键盘（缺口 #6 收尾）：Left/Right 在词间移动，Enter/Space 激活选中词。
+            case UiEvent.KeyDown(Key.Left, _) => return wordStep(ctx, -1)
+            case UiEvent.KeyDown(Key.Right, _) => return wordStep(ctx, 1)
+            case UiEvent.KeyDown(Key.Enter, _) => return wordActivate(ctx)
+            case UiEvent.KeyDown(Key.Space, _) => return wordActivate(ctx)
             case _ => false
         }
     }
 
+    // 键盘移动：未定（-1）落到第一个词；随后在词数范围内左右收住。
+    private func wordStep(ctx: UiContext, delta: Int64): Bool {
+        if (!ctx.hasFocus(id) || placed.isEmpty()) {
+            return false
+        }
+        let now = keyboardIdx.value
+        if (now < 0) {
+            keyboardIdx.value = 0
+            return true
+        }
+        keyboardIdx.value = max(0, min(placed.size - 1, now + delta))
+        true
+    }
+
+    private func wordActivate(ctx: UiContext): Bool {
+        if (!ctx.hasFocus(id)) {
+            return false
+        }
+        let idx = keyboardIdx.value
+        if (idx < 0 || idx >= placed.size) {
+            keyboardIdx.value = 0
+            return true
+        }
+        onClick(placed[idx].item)
+        true
+    }
+
+    // 词的 key 在 placed 中的序号；不在则为 -1。
+    private func wordKeyIndex(key: String): Int64 {
+        for (i in 0..placed.size) {
+            if (placed[i].item.key == key) {
+                return Int64(i)
+            }
+        }
+        -1
+    }
+
+    public func focusableId(): ?String {
+        if (items.isEmpty()) {
+            None
+        } else {
+            Some(id)
+        }
+    }
+
     public func isFlexible(): Bool {
         false
     }
