+package cui.controls
+
+import lgui.{FrameInfo, Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+/* WordCloud 键盘（缺口 #6 收尾）：聚焦、Left/Right 走词、Enter/Space 激活。 */
+@Test
+func wordCloudKeyboardWalksAndActivates(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    ctx.viewportWidth = 400.0
+    ctx.viewportHeight = 300.0
+    let picked = State<String>("")
+    let cloud = WordCloud(
+        [
+            WordCloudItem("a", "仓颉", 100.0),
+            WordCloudItem("b", "图形界面", 50.0),
+            WordCloudItem("c", "词云", 20.0)
+        ],
+        onClick: {item => picked.value = item.key},
+        key: "wc.kbd"
+    )
+    cloud.layout(ctx, Rect(0.0, 0.0, 400.0, 300.0))
+    @Expect(cloud.focusableId().isSome()) // 有词即进焦点环
+
+    // 未聚焦不消费。
+    @Expect(!cloud.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+
+    // 点击聚焦（第一词中心因布局而异——点控件中心即可，命中任一词都行；
+    // 若中心是空隙则只聚焦不激活，仍可走键盘）。
+    let _ = cloud.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 200.0, 150.0))
+    @Expect(ctx.hasFocus("wc.kbd"))
+
+    // Right 从未定 → 词 0；再 Right → 词 1；Enter 激活。
+    @Expect(cloud.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(cloud.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(cloud.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(picked.value, "b")
+
+    // Left 回到词 0，Space 激活。
+    @Expect(cloud.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(cloud.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(picked.value, "a")
+}
+
+@Test
+func wordCloudEmptyStaysOutOfFocusRing(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let cloud = WordCloud([], key: "wc.empty")
+    cloud.layout(ctx, Rect(0.0, 0.0, 400.0, 300.0))
+    @Expect(cloud.focusableId().isNone()) // 空词云不是 Tab 停靠点
+    @Expect(!cloud.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+}
