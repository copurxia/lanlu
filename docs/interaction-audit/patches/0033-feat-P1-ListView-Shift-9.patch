-    private func applySelection(index: Int64): Unit {
+    private func applySelection(index: Int64, keepAnchor: Bool): Unit {
+        // Shift 扩展：保持锚点（无锚点时以当前 selected 起锚）；普通选择把锚点移到 index。
+        if (keepAnchor) {
+            if (selectionAnchor.value == Int64.Min) {
+                selectionAnchor.value = selected.value
+            }
+        } else {
+            selectionAnchor.value = index
+        }
         selected.value = index
         // Scroll immediately (this frame's handle) and sync lastRevealed so draw does not redo it.
         revealRow(index)
         lastRevealed.value = index
     }
 
+    // 键盘版：Shift+方向/Home/End 保持锚点扩展，普通方向键重置锚点。
+    private func extendOrMove(ctx: UiContext, delta: Int64, keepAnchor: Bool): Bool {
+        if (!ctx.hasFocus(controlId) || items.isEmpty()) {
+            return false
+        }
+        applySelection(clampIndex(selected.value + delta), keepAnchor)
+        true
+    }
+
+    private func extendOrJump(ctx: UiContext, index: Int64, keepAnchor: Bool): Bool {
+        if (!ctx.hasFocus(controlId) || items.isEmpty()) {
+            return false
+        }
+        applySelection(clampIndex(index), keepAnchor)
+        true
+    }
+
+    /** 当前 Shift 区间（含两端）；无锚点时退化为单点 (selected, selected)。 */
+    public func selectionRange(): (Int64, Int64) {
+        let anchor = selectionAnchor.value
+        if (anchor == Int64.Min) {
+            return (selected.value, selected.value)
+        }
+        if (anchor <= selected.value) {
+            (anchor, selected.value)
+        } else {
+            (selected.value, anchor)
+        }
+    }
+
