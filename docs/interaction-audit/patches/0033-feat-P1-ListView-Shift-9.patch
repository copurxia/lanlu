+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+private func rangeContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/* Shift 区间选择（缺口 #9）：锚点语义 + 区间查询 + 键盘扩展。 */
+@Test
+func shiftClickGrowsRangeFromAnchor(): Unit {
+    let ctx = rangeContext()
+    let selected = State<Int64>(0)
+    let list = ListView(["a", "b", "c", "d", "e"], selected, key: "rg.list")
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 300.0))
+
+    // 普通点击第 2 行（viewport 顶从 0 开始，行高 CUI_SMALL_H）。
+    let rowY = Float32(2.5 * 28.0)
+    let _ = list.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, rowY))
+    @Expect(selected.value, Int64(2))
+    let (s0, e0) = list.selectionRange()
+    @Expect(s0, Int64(2)) // 普通点击：区间退化为单点
+    @Expect(e0, Int64(2))
+}
+
+@Test
+func shiftArrowExtendsRange(): Unit {
+    let ctx = rangeContext()
+    let selected = State<Int64>(1)
+    let list = ListView(["a", "b", "c", "d", "e"], selected, key: "rg.kbd")
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 300.0))
+    ctx.focus("rg.kbd", viaKeyboard: true)
+
+    // Shift+Down 两次：从 1 扩到 3，区间 (1,3)。
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Down, true)))
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Down, true)))
+    @Expect(selected.value, Int64(3))
+    let (s, e) = list.selectionRange()
+    @Expect(s, Int64(1))
+    @Expect(e, Int64(3))
+
+    // 普通方向键重置锚点：区间退化为单点。
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Down, false)))
+    let (s2, e2) = list.selectionRange()
+    @Expect(s2, Int64(4))
+    @Expect(e2, Int64(4))
+}
+
+@Test
+func shiftHomeSelectsToTop(): Unit {
+    let ctx = rangeContext()
+    let selected = State<Int64>(3)
+    let list = ListView(["a", "b", "c", "d", "e"], selected, key: "rg.home")
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 300.0))
+    ctx.focus("rg.home", viaKeyboard: true)
+
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Home, true)))
+    @Expect(selected.value, Int64(0))
+    let (s, e) = list.selectionRange()
+    @Expect(s, Int64(0))
+    @Expect(e, Int64(3))
+}
