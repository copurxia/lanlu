     localState}
 
 private let CONTEXT_MENU_MARGIN: Float32 = 4.0
+// USB HID scancode of F10：Shift+F10 是 Windows 的“上下文菜单”键盘等价物。
+private let F10_SCANCODE: Int32 = 68
 
 /*
  * Wraps a control with a right-click context menu. A secondary press inside the child opens a
@@ -69,11 +72,52 @@ public class ContextMenu <: Widget {
                     highlight.value = menuFirstSelectable(items)
                     return true
                 }
+            // 键盘唤起（缺口 #13）：Menu 键或 Shift+F10 在键盘焦点位于本控件子树内时
+            // 于控件中心弹出——桌面惯例（右键的键盘等价物）。
+            case UiEvent.KeyDown(Key.Menu, _) => return openByKeyboard(ctx, event)
+            // Shift+F10：F10 不在 Key 枚举（非字母/数字），经 RawScancode(68) 匹配。
+            case UiEvent.KeyDown(Key.RawScancode(F10_SCANCODE), _) =>
+                if (Keyboard.modifiers().shift) {
+                    return openByKeyboard(ctx, event)
+                }
             case _ => ()
         }
         child.handle(ctx, event)
     }
 
+    // 键盘焦点在子树内（含子控件自身持有焦点）时于控件中心弹出；否则把事件交还子树。
+    private func openByKeyboard(ctx: UiContext, event: UiEvent): Bool {
+        if (items.isEmpty() || !focusInside(ctx)) {
+            return child.handle(ctx, event)
+        }
+        open.value = true
+        menuX.value = frame.centerX()
+        menuY.value = frame.centerY()
+        highlight.value = menuFirstSelectable(items)
+        true
+    }
+
+    // 键盘焦点是否落在被包裹子树的某个停靠点上。
+    private func focusInside(ctx: UiContext): Bool {
+        let focused = ctx.focusId
+        if (focused.size == 0) {
+            return false
+        }
+        match (child.focusableId()) {
+            case Some(id) =>
+                if (id == focused) {
+                    return true
+                }
+            case None => ()
+        }
+        for (stop in child.focusableIds()) {
+            if (stop == focused) {
+                return true
+            }
+        }
+        false
+    }
+
     public func isFlexible(): Bool {
         child.isFlexible()
     }
