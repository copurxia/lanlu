+++ b/src/core/focus_target_test.cj
@@ -0,0 +1,76 @@
+package cui.core
+
+import lgui.{FrameInfo, Key, MouseButton, Rect, Size, UiEvent}
+
+/* FocusTarget：自绘内容的焦点/激活底座（缺口 #2 的框架侧）。 */
+private class ColoredBox <: Widget {
+    public init() {
+        emit(this)
+    }
+
+    public func measure(_: UiContext, _: Size): Size {
+        Size(80.0, 40.0)
+    }
+
+    public func layout(_: UiContext, _: Rect): Unit {}
+
+    public func draw(_: UiContext): Unit {}
+
+    public func handle(_: UiContext, _: UiEvent): Bool {
+        false
+    }
+}
+
+@Test
+func focusTargetRegistersAndActivatesByKeyboard(): Unit {
+    let ctx = testContext()
+    let fired = State<Bool>(false)
+    let target = FocusTarget(onClick: {=> fired.value = true}, key: "ft.card") {
+        emit(ColoredBox())
+    }
+    target.layout(ctx, Rect(0.0, 0.0, 80.0, 40.0))
+
+    @Expect(!target.handle(ctx, UiEvent.KeyDown(Key.Enter, false))) // 未聚焦不激活
+    @Expect(!fired.value)
+
+    // 点击聚焦（按下+抬起都在框内 → 激活一次）。
+    @Expect(target.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 40.0, 20.0)))
+    @Expect(ctx.hasFocus("ft.card"))
+    @Expect(target.handle(ctx, UiEvent.MouseUp(MouseButton.Left, 40.0, 20.0)))
+    @Expect(fired.value)
+
+    // 键盘激活：Enter 与 Space。
+    fired.value = false
+    @Expect(target.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(fired.value)
+    fired.value = false
+    @Expect(target.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(fired.value)
+}
+
+@Test
+func focusTargetReleaseOutsideCancelsActivation(): Unit {
+    let ctx = testContext()
+    let fired = State<Bool>(false)
+    let target = FocusTarget(onClick: {=> fired.value = true}, key: "ft.cancel") {
+        emit(ColoredBox())
+    }
+    target.layout(ctx, Rect(0.0, 0.0, 80.0, 40.0))
+
+    let _ = target.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 40.0, 20.0))
+    // 抬起在框外：不激活（按钮语义：移出取消）。
+    @Expect(target.handle(ctx, UiEvent.MouseUp(MouseButton.Left, 200.0, 200.0)))
+    @Expect(!fired.value)
+}
+
+@Test
+func focusTargetReportsOwnStopBeforeChildStops(): Unit {
+    let inner = Button("内", {=> ()}).key("ft.inner")
+    let target = FocusTarget(onClick: {=> ()}, key: "ft.outer") {
+        emit(inner)
+    }
+    let ids = target.focusableIds()
+    @Expect(ids.size, Int64(2))
+    @Expect(ids[0], "ft.outer")
+    @Expect(ids[1], "ft.inner")
+}
