+package cui.controls
+
+import lgui.{Key, Rect, Renderer, UiEvent}
+import cui.core.{Button, Theme, UiContext}
+import std.collection.ArrayList
+
+private func reorderContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/*
+ * 键盘重排（无障碍入口）：Alt+Up/Down 移动持焦行。修饰键无法在单测里伪造，
+ * 这里固定两条可确定的行为：
+ * 1) 未按 Alt 时方向键不被子列表拦截（继续下发给行内容）；
+ * 2) 行停靠点被完整冒泡到列表层（键盘能 Tab 到行，才有"持焦行"可移动）。
+ */
+@Test
+func reorderableListDoesNotSwallowPlainArrows(): Unit {
+    let ctx = reorderContext()
+    let moves = ArrayList<(Int64, Int64)>()
+    let list = ReorderableList(3, 40.0, {from, to => moves.add((from, to))}, id: "ro.list") {
+        i => Button("行 ${i}", {=> ()}).key("ro.row.${i}")
+    }
+    list.layout(ctx, Rect(0.0, 0.0, 300.0, 200.0))
+    ctx.focus("ro.row.1", viaKeyboard: true)
+
+    @Expect(!list.handle(ctx, UiEvent.KeyDown(Key.Down, false)))
+    @Expect(moves.size, Int64(0))
+}
+
+@Test
+func reorderableListBubblesRowFocusStops(): Unit {
+    let list = ReorderableList(3, 40.0, {from, to => ()}, id: "ro.stops") {
+        i => Button("行 ${i}", {=> ()}).key("ro.stop.${i}")
+    }
+    let ids = list.focusableIds()
+    @Expect(ids.size, Int64(3))
+    @Expect(ids[0], "ro.stop.0")
+    @Expect(ids[2], "ro.stop.2")
+}
