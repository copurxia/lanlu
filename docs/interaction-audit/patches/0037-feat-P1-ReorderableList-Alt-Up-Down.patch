     }
 
+    // Alt 由修饰键快照判定（KeyDown 的位与后端无关）。
+    private func altPressed(): Bool {
+        Keyboard.modifiers().alt
+    }
+
+    /*
+     * 键盘重排：找出当前焦点所在的行（该行的任一停靠点是 ctx.focusId），把它与相邻行交换。
+     * 通过调用方的 onMove 提交，和拖拽走同一条数据通路，界面在下一帧重建时生效。
+     * 焦点跟随被移动的行——用本地状态记住"移动后应把焦点放到哪个 id"，因为行是重建出来的。
+     */
+    private func moveFocusedRow(ctx: UiContext, delta: Int64): Bool {
+        let focusId = ctx.focusId
+        if (focusId.size == 0) {
+            return false
+        }
+        var index = -1
+        for (i in 0..rows.size) {
+            for (fid in rows[i].focusableIds()) {
+                if (fid == focusId) {
+                    index = i
+                }
+            }
+        }
+        if (index < 0) {
+            return false
+        }
+        let target = index + delta
+        if (target < 0 || target >= rows.size) {
+            return false
+        }
+        onMove(index, target)
+        return true
+    }
+
