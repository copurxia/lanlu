+package cui.text
+
+import lgui.{Canvas, Color, Rect, Renderer}
+import cui.core.{State, Theme, UiContext}
+
+/* 字段三态契约（缺口 #10）：常态 / 悬停 / 激活在底色与边上有明确区别。 */
+@Test
+func fieldSurfaceHasDistinctHoverState(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.dark())
+    let idle = ctx.theme.fieldSurface(false)
+    let hover = ctx.theme.fieldSurface(false, hovered: true)
+    let active = ctx.theme.fieldSurface(true)
+
+    // 悬停与常态可区分：底色与边都不同。
+    @Expect(!(hover.fill == idle.fill))
+    @Expect(!(hover.border == idle.border))
+    // 激活（聚焦）与悬停再区分：边是全强调色，悬停是 40% 过渡色。
+    @Expect(!(active.border == hover.border))
+    @Expect(active.border == ctx.theme.accent)
+    // 激活优先于悬停（两者同时为真时取激活）。
+    let both = ctx.theme.fieldSurface(true, hovered: true)
+    @Expect(both.border == active.border)
+    @Expect(both.fill == active.fill)
+}
+
+@Test
+func textFieldHoverIdMatchesFieldId(): Unit {
+    // 字段在悬停时以自身焦点 id 认领 hover——chrome 读的 isHovered(id) 才可能命中。
+    let field = TextField(State<String>("abc"), key: "hover.field")
+    @Expect(field.focusableId().getOrThrow() == "hover.field")
+}
