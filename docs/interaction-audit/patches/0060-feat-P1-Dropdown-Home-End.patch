diff --git a/src/controls/dropdown.cj b/src/controls/dropdown.cj
index 3bdd736..df271cf 100644
--- a/src/controls/dropdown.cj
+++ b/src/controls/dropdown.cj
@@ -193,6 +193,17 @@ public class Dropdown <: Widget {
             case UiEvent.KeyDown(Key.Up, _) =>
                 moveHighlight(-1, popup)
                 true
+            // Home/End 跳首/尾（与 ComboBox/ListView/Table 同一约定）。
+            case UiEvent.KeyDown(Key.Home, _) =>
+                if (items.size > 0) {
+                    moveHighlight(-selected.value, popup)
+                }
+                true
+            case UiEvent.KeyDown(Key.End, _) =>
+                if (items.size > 0) {
+                    moveHighlight(items.size - 1 - selected.value, popup)
+                }
+                true
             case UiEvent.KeyDown(Key.Tab, _) =>
                 close(ctx) // commit and let the shell's Tab traversal move focus on
                 false
