+package cui.text
+
+/* 按词编辑（缺口 #18 后半）：词边界与双击选词同一套脚本分类。 */
+@Test
+func wordMotionSkipsSpaceAndStopsAtScriptBoundary(): Unit {
+    let state = TextEditState("hello 世界！")
+    // 光标在末尾：moveWordLeft 应跳过紧邻空白回到「世界」的词首。
+    state.cursor.value = "hello 世界！".size
+    state.anchor.value = "hello 世界！".size
+    state.moveWordLeft()
+    @Expect(state.cursor.value, Int64("hello ".size))
+
+    // 再往左一次应落到 "hello" 的词首（跳过空白）。
+    state.moveWordLeft()
+    @Expect(state.cursor.value, Int64(0))
+}
+
+@Test
+func wordMotionRightLandsAfterEachWord(): Unit {
+    let state = TextEditState("hello 世界！")
+    // 构造后 cursor/anchor 都在末尾；先把 anchor 一起归零，避免"已有选区"分支把起点拉到 selectionEnd。
+    state.cursor.value = 0
+    state.anchor.value = 0
+    state.moveWordRight()
+    @Expect(state.cursor.value, Int64("hello".size)) // 停在 "hello" 词尾（空白前）
+    state.moveWordRight()
+    @Expect(state.cursor.value, Int64("hello 世界".size)) // 跳过空白，停在「界」后
+}
+
+@Test
+func deleteWordBackwardRemovesWholeCjkWord(): Unit {
+    let state = TextEditState("你好world")
+    state.cursor.value = "你好world".size
+    state.anchor.value = "你好world".size
+    state.deleteWordBackward()
+    @Expect(state.text.value, "你好") // Ctrl+Backspace 删掉 ASCII 词，汉字保留
+
+    // 汉字连续串是同一个"词"（与双击选词同语义）：再删一次整串删光，而不是逐字。
+    state.deleteWordBackward()
+    @Expect(state.text.value, "")
+}
+
+@Test
+func deleteWordForwardRemovesLeadingWord(): Unit {
+    let state = TextEditState("你好 world")
+    state.cursor.value = 0
+    state.anchor.value = 0
+    state.deleteWordForward()
+    @Expect(state.text.value, " world") // Ctrl+Delete 删掉「你好」，空白与后词保留
+}
+
+@Test
+func extendWordLeftGrowsSelectionByWord(): Unit {
+    let state = TextEditState("hello 世界")
+    state.cursor.value = "hello 世界".size
+    state.anchor.value = "hello 世界".size
+    state.extendWordLeft()
+    @Expect(state.selectionStart(), Int64("hello ".size))
+    @Expect(state.selectionEnd(), Int64("hello 世界".size)) // 选中的是「世界」
+}
