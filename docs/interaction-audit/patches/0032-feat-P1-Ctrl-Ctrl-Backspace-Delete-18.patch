diff --git a/src/text/text_edit_state.cj b/src/text/text_edit_state.cj
index fa54e23..2e05bce 100644
--- a/src/text/text_edit_state.cj
+++ b/src/text/text_edit_state.cj
@@ -111,6 +111,110 @@ public class TextEditState {
         }
     }
 
+    /*
+     * 按词操作（缺口 #18 后半）：词边界由 charClassAt 的脚本分类决定——同一类连续字符构成
+     * 一个"词"（ASCII 单词、汉字、假名、谚文、空白、标点各自成词），与双击选词同一套语义。
+     */
+    public func moveWordLeft(): Unit {
+        let content = text.value
+        var pos = normalizedTextCursor(content, cursor.value)
+        if (hasSelection()) {
+            pos = selectionStart()
+            cursor.value = pos
+            anchor.value = pos
+        }
+        // 跳过紧邻的空白，再吃掉同一类的连续字符。
+        while (pos > 0 && charClassAt(content, pos - 1) == CHAR_CLASS_SPACE) {
+            pos = previousTextBoundary(content, pos)
+        }
+        if (pos > 0) {
+            let cls = charClassAt(content, pos - 1)
+            while (pos > 0 && charClassAt(content, pos - 1) == cls) {
+                pos = previousTextBoundary(content, pos)
+            }
+        }
+        cursor.value = pos
+        anchor.value = pos
+    }
+
+    public func moveWordRight(): Unit {
+        let content = text.value
+        var pos = normalizedTextCursor(content, cursor.value)
+        if (hasSelection()) {
+            pos = selectionEnd()
+        }
+        while (pos < content.size && charClassAt(content, pos) == CHAR_CLASS_SPACE) {
+            pos = nextTextBoundary(content, pos)
+        }
+        if (pos < content.size) {
+            let cls = charClassAt(content, pos)
+            while (pos < content.size && charClassAt(content, pos) == cls) {
+                pos = nextTextBoundary(content, pos)
+            }
+        }
+        cursor.value = pos
+        anchor.value = pos
+    }
+
+    /** 删除光标左侧的一个词（Ctrl+Backspace）。 */
+    public func deleteWordBackward(): Unit {
+        if (deleteSelection()) {
+            return
+        }
+        let end = normalizedTextCursor(text.value, cursor.value)
+        let before = cursor.value
+        moveWordLeft()
+        let start = cursor.value
+        if (start >= end) {
+            cursor.value = before
+            anchor.value = before
+            return
+        }
+        text.value = text.value[0..start] + text.value[end..text.value.size]
+        cursor.value = start
+        anchor.value = start
+    }
+
+    /** 删除光标右侧的一个词（Ctrl+Delete）。 */
+    /** Shift 扩展到左侧词边界（Ctrl+Shift+Left）。 */
+    public func extendWordLeft(): Unit {
+        let before = cursor.value
+        let hadSelection = hasSelection()
+        let anchorBefore = anchor.value
+        moveWordLeft()
+        if (!hadSelection) {
+            anchor.value = anchorBefore
+        }
+        if (cursor.value == before && !hadSelection) {
+            anchor.value = before
+        }
+    }
+
+    /** Shift 扩展到右侧词边界（Ctrl+Shift+Right）。 */
+    public func extendWordRight(): Unit {
+        let hadSelection = hasSelection()
+        let anchorBefore = anchor.value
+        moveWordRight()
+        if (!hadSelection) {
+            anchor.value = anchorBefore
+        }
+    }
+
+    public func deleteWordForward(): Unit {
+        if (deleteSelection()) {
+            return
+        }
+        let start = normalizedTextCursor(text.value, cursor.value)
+        moveWordRight()
+        let end = cursor.value
+        if (end <= start) {
+            return
+        }
+        text.value = text.value[0..start] + text.value[end..text.value.size]
+        cursor.value = start
+        anchor.value = start
+    }
+
     /** Collapses any selection onto the caret. */
     public func clearSelection(): Unit {
         anchor.value = normalizedTextCursor(text.value, cursor.value)
diff --git a/src/text/text_field.cj b/src/text/text_field.cj
index 4b5d315..2b87a5f 100644
--- a/src/text/text_field.cj
