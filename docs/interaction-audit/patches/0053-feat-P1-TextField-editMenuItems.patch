 import lgui.{FontSizes, IconName, Key, MouseButton, Rect, Size, UiEvent, drawIcon}
 import lgui.input.{Clipboard, Keyboard}
+import cui.controls.MenuItem
 import cui.core.{Bindable, CUI_CONTROL_H, CursorShape, State, UiContext, Widget, claimHoverIfInside, emit, localState,
     registerFocusable, resolveControlKey}
 
@@ -395,6 +396,47 @@ public class TextField <: Widget {
         false
     }
 
+    /*
+     * 标准编辑菜单项（右键菜单的键盘/指针等价物）：剪切/复制/粘贴/全选，按当前状态置灰
+     * （无选区时剪切/复制灰，不可编辑时剪切/粘贴灰）。用法：
+     *   let field = TextField(text, key: "t")
+     *   ContextMenu(items: field.editMenuItems()) { field }
+     * 这样右键字段即得桌面惯例的编辑菜单；动作与 Ctrl+X/C/V/A 走同一套路径
+     * （剪贴板 best-effort，undo 历史一致记录）。
+     */
+    public func editMenuItems(): Array<MenuItem> {
+        let edit = editState()
+        let hasSelection = edit.hasSelection()
+        let editable = isEditable
+        // 与 recordedEdit 相同的 before/after 记录（菜单动作无 ctx 可传，elapsedMs 用 0——
+        // 只影响连打分组，不影响可撤销性）。
+        func recordedMenuEdit(action: () -> Unit): Unit {
+            let before = snapshot()
+            action()
+            if (text.value != before.text) {
+                history.commit(before, UInt64(0))
+            }
+        }
+        return [
+            MenuItem("剪切", {=> let _ = copySelection(edit); recordedMenuEdit({=> let _ = edit.deleteSelection()})},
+                shortcut: "Ctrl+X", enabled: hasSelection && editable),
+            MenuItem("复制", {=> let _ = copySelection(edit)},
+                shortcut: "Ctrl+C", enabled: hasSelection),
+            MenuItem("粘贴", {=> recordedMenuEdit({=> edit.insert(flattenLines(clipText()))})},
+                shortcut: "Ctrl+V", enabled: editable),
+            MenuItem("全选", {=> edit.selectAll()},
+                shortcut: "Ctrl+A"),
+        ]
+    }
+
+    private func clipText(): String {
+        try {
+            Clipboard.getText()
+        } catch (_: Exception) {
+            ""
+        }
+    }
+
     // Clipboard access can fail where there is no desktop session; treat it as best-effort
     // so a copy or paste never crashes the field.
     private func copySelection(edit: TextEditState): Bool {
