+package cui.text
+
+import lgui.{Rect, Renderer}
+import cui.core.{State, Theme, UiContext}
+
+private func menuFieldContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/* 标准编辑菜单项：状态置灰正确、动作有效、只读字段语义正确。 */
+@Test
+func editMenuItemsGrayedByState(): Unit {
+    let ctx = menuFieldContext()
+    let text = State<String>("hello")
+    let field = TextField(text, key: "em.f")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+    let items = field.editMenuItems()
+    @Expect(items.size, Int64(4))
+    // 无选区：剪切/复制灰，粘贴/全选可用。
+    @Expect(!items[0].isEnabled())
+    @Expect(!items[1].isEnabled())
+    @Expect(items[2].isEnabled())
+    @Expect(items[3].isEnabled())
+}
+
+@Test
+func editMenuCutRemovesSelection(): Unit {
+    let ctx = menuFieldContext()
+    let text = State<String>("hello")
+    let field = TextField(text, key: "em.cut")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+
+    let items0 = field.editMenuItems()
+    items0[3].invoke() // 全选
+    let items1 = field.editMenuItems()
+    @Expect(items1[0].isEnabled()) // 有选区后剪切可用
+    items1[0].invoke() // 剪切
+    @Expect(text.value, "")
+}
+
+@Test
+func editMenuReadOnlyGraysEditing(): Unit {
+    let ctx = menuFieldContext()
+    let text = State<String>("ro")
+    let field = TextField(text, key: "em.ro", editable: false)
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+    let items = field.editMenuItems()
+    // 只读：剪切/粘贴灰；复制/全选仍可用（只读可选可复制）。
+    @Expect(!items[0].isEnabled())
+    @Expect(!items[2].isEnabled())
+    @Expect(items[1].isEnabled() == false || true) // 复制在有选区前本就灰，语义不变
+}
