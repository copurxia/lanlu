diff --git a/src/text/text_area.cj b/src/text/text_area.cj
index 36297b4..e62e1f4 100644
--- a/src/text/text_area.cj
+++ b/src/text/text_area.cj
@@ -177,10 +177,28 @@ public class TextArea <: Widget {
                 }
             case UiEvent.TextInput(value) => return recordedEdit(ctx, {=> edit.insert(value)})
             case UiEvent.KeyDown(Key.Enter, _) => return recordedEdit(ctx, {=> edit.insert("\n")})
-            case UiEvent.KeyDown(Key.Backspace, _) => return recordedEdit(ctx, {=> edit.backspace()})
-            case UiEvent.KeyDown(Key.Delete, _) => return recordedEdit(ctx, {=> edit.deleteForward()})
-            case UiEvent.KeyDown(Key.Left, _) => return navigate(ctx, {=> edit.moveLeft()}, {=> edit.extendLeft()})
-            case UiEvent.KeyDown(Key.Right, _) => return navigate(ctx, {=> edit.moveRight()}, {=> edit.extendRight()})
+            // 按词编辑（与 TextField 同一约定）：Ctrl+方向键跳词边界、Ctrl+Backspace/Delete 删词。
+            // 词边界与双击选词同一套脚本分类（ASCII 单词/汉字/假名/空白/标点各自成词）。
+            case UiEvent.KeyDown(Key.Backspace, _) =>
+                if (Keyboard.modifiers().ctrl) {
+                    return recordedEdit(ctx, {=> edit.deleteWordBackward()})
+                }
+                return recordedEdit(ctx, {=> edit.backspace()})
+            case UiEvent.KeyDown(Key.Delete, _) =>
+                if (Keyboard.modifiers().ctrl) {
+                    return recordedEdit(ctx, {=> edit.deleteWordForward()})
+                }
+                return recordedEdit(ctx, {=> edit.deleteForward()})
+            case UiEvent.KeyDown(Key.Left, _) =>
+                if (Keyboard.modifiers().ctrl) {
+                    return navigate(ctx, {=> edit.moveWordLeft()}, {=> edit.extendWordLeft()})
+                }
+                return navigate(ctx, {=> edit.moveLeft()}, {=> edit.extendLeft()})
+            case UiEvent.KeyDown(Key.Right, _) =>
+                if (Keyboard.modifiers().ctrl) {
+                    return navigate(ctx, {=> edit.moveWordRight()}, {=> edit.extendWordRight()})
+                }
+                return navigate(ctx, {=> edit.moveRight()}, {=> edit.extendRight()})
             case UiEvent.KeyDown(Key.Up, _) => return navigate(ctx, {=> edit.moveLineUp()}, {=> edit.extendLineUp()})
             case UiEvent.KeyDown(Key.Down, _) => return navigate(ctx, {=> edit.moveLineDown()},
                 {=> edit.extendLineDown()})
diff --git a/src/text/text_area_word_keys_test.cj b/src/text/text_area_word_keys_test.cj
