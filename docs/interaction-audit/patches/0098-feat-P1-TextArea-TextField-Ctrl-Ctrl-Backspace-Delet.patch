@@ -0,0 +1,41 @@
+package cui.text
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+/*
+ * TextArea 按词操作（与 TextField 同一约定）：Ctrl+Backspace 删前一个词、Ctrl+← 按词左移、
+ * Ctrl+Shift+→ 按词扩选。无符号位只声明按键；修饰键经 Keyboard.modifiers() 读取，headless 下
+ * 默认无修饰——这里通过无 Ctrl 的基线对照 + TextEditState 的词边界语义交叉验证。
+ */
+private func wordContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+@Test
+func textAreaCtrlBackspaceDeletesPreviousWord(): Unit {
+    let ctx = wordContext()
+    let body = State<String>("hello world")
+    let area = TextArea(body, key: "word.area")
+    area.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+    let _ = area.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 190.0, 20.0)) // 点到末尾
+    // 无修饰的 Backspace 基线：删一个字符。
+    @Expect(area.handle(ctx, UiEvent.KeyDown(Key.Backspace, false)))
+    @Expect(body.value, "hello worl")
+}
+
+@Test
+func textAreaWordMotionMethodsExistOnEditState(): Unit {
+    // 直接锁定 TextArea 所用 TextEditState 的按词语义（TextArea.handle 的 Ctrl 分支只是转发）。
+    // 偏移按 UTF-8 字节计："hello 世界!" 共 13 字节（h e l l o ␣ 世×3 界×3 !）。
+    // 词分类：hello=单词、␣=空白、世界=汉字、!=标点，各自成词。
+    let edit = TextEditState("hello 世界!")
+    edit.moveToEnd()
+    @Expect(edit.cursor.value, Int64(13))
+    edit.moveWordLeft() // 标点 "!" 自成一词
+    @Expect(edit.cursor.value, Int64(12))
+    edit.moveWordLeft() // 汉字 "世界" 一词（6 字节）
+    @Expect(edit.cursor.value, Int64(6))
+    edit.moveWordLeft() // 单词 "hello"（越过空白）
+    @Expect(edit.cursor.value, Int64(0))
+}
