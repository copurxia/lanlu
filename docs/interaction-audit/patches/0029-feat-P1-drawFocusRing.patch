 public import cui.core.FocusTarget
 public import cui.core.registerFocusStop
 public import cui.core.reregisterFocusStop
+public import cui.core.drawFocusRing
 public import cui.core.FlowRow
 public import cui.core.ForEach
 public import cui.core.ForEachIndexed
