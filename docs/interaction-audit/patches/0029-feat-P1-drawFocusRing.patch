 src/core/surface_draw.cj        |  5 ++-
 src/cui.cj                      |  1 +
 3 files changed, 68 insertions(+), 1 deletion(-)
 create mode 100644 src/core/focus_ring_api_test.cj

diff --git a/src/core/focus_ring_api_test.cj b/src/core/focus_ring_api_test.cj
new file mode 100644
index 0000000..5d920ad
--- /dev/null
+++ b/src/core/focus_ring_api_test.cj
@@ -0,0 +1,63 @@
+package cui.core
+
+import std.collection.ArrayList
+import lgui.{Canvas, Color, Pen, Rect, Renderer, Size, UiEvent}
+
+/* 记录描边的画布：验证对外公开的 drawFocusRing 画的是统一外环（accent、外扩 2px、1.6px）。 */
+private class RingProbe <: Canvas {
+    let strokes = ArrayList<(Rect, Pen)>()
+
+    public func beginFrame(clear: Color): Unit {}
+    public func present(): Unit {}
+    public func captureTo(path: String): Int32 {
+        0
+    }
+    public func fill(rect: Rect, color: Color): Unit {}
+    public func fillRoundedRect(rect: Rect, radius: Float32, color: Color): Unit {}
+    public func fillRectGradient(rect: Rect, from: Color, to: Color, vertical: Bool): Unit {}
+    public func drawTextureRounded(id: Int64, destination: Rect, source: ?Rect, radius: Float32, alpha: Float32): Unit {}
+    public func fillRoundedRectSoft(rect: Rect, radius: Float32, color: Color, feather!: Float32): Unit {}
+    public func strokeRect(rect: Rect, pen: Pen): Unit {
+        strokes.add((rect, pen))
+    }
+    public func strokeRoundedRect(rect: Rect, radius: Float32, pen: Pen): Unit {
+        strokes.add((rect, pen))
+    }
+    public func strokeLine(x1: Float32, y1: Float32, x2: Float32, y2: Float32, pen: Pen): Unit {}
+    public func line(x1: Float32, y1: Float32, x2: Float32, y2: Float32, color: Color): Unit {}
+    public func fillCircle(cx: Float32, cy: Float32, radius: Float32, color: Color): Unit {}
+    public func strokeCircle(cx: Float32, cy: Float32, radius: Float32, pen: Pen, segments!: Int64): Unit {}
+    public func drawTexture(id: Int64, destination: Rect, source: ?Rect, alpha: Float32): Unit {}
+    public func uploadTexture(id: Int64, width: Int32, height: Int32, pixels: Array<UInt8>): Unit {}
+    public func uploadTexturePng(id: Int64, bytes: Array<UInt8>): Unit {}
+    public func releaseTexture(id: Int64): Unit {}
+    public func pushClip(rect: Rect): Unit {}
+    public func popClip(): Unit {}
+    public func text(text: String, x: Float32, y: Float32, color: Color, pointSize!: Float32): Unit {}
+    public func textWidth(text: String, pointSize!: Float32): Float32 {
+        40.0
+    }
+    public func textHeight(pointSize!: Float32): Float32 {
+        16.0
+    }
+    public func textCenter(text: String, rect: Rect, color: Color, pointSize!: Float32): Unit {}
+}
+
+@Test
+func drawFocusRingPaintsAccentHaloOutsideBounds(): Unit {
+    let probe = RingProbe()
+    let renderer = Renderer.headless()
+    renderer.useBackend(probe)
+    let ctx = UiContext(renderer, Theme.dark())
+
+    drawFocusRing(ctx, Rect(10.0, 20.0, 100.0, 30.0), 6.0)
+    @Expect(probe.strokes.size, Int64(1))
+    let (rect, pen) = probe.strokes[0]
+    // 外扩 2px：x 8、y 18、w 104、h 34。
+    @Expect(rect.x, Float32(8.0))
+    @Expect(rect.y, Float32(18.0))
+    @Expect(rect.w, Float32(104.0))
+    @Expect(rect.h, Float32(34.0))
+    @Expect(pen.color, ctx.theme.accent)
+    @Expect(pen.width, Float32(1.6))
+}
diff --git a/src/core/surface_draw.cj b/src/core/surface_draw.cj
index 2026a2d..5ce3aab 100644
--- a/src/core/surface_draw.cj
+++ b/src/core/surface_draw.cj
@@ -48,8 +48,11 @@ private func faded(color: Color, fade: Float32): Color {
  * outside its bounds so it reads as a halo distinct from the control's own edge. Every focusable
  * control paints one (gated on `showFocusRing`, so it shows for keyboard focus only), giving Tab
  * navigation a uniform, visible indicator across buttons, toggles and fields alike.
+ *
+ * Public: application-level self-drawn controls that register a stop via `registerFocusStop` must be
+ * able to paint the same ring, otherwise each app re-invents one and the visual language splits.
  */
-protected func drawFocusRing(ctx: UiContext, rect: Rect, radius: Float32): Unit {
+public func drawFocusRing(ctx: UiContext, rect: Rect, radius: Float32): Unit {
     ctx.renderer.strokeRoundedRect(rect.inset(-2.0), radius + 2.0, Pen(width: 1.6, color: ctx.theme.accent))
 }
 
