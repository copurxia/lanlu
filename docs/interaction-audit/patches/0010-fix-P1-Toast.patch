@@ -0,0 +1,119 @@
+package cui.controls
+
+import lgui.{Canvas, Color, FrameInfo, MouseButton, Pen, Rect, Renderer, UiEvent}
+import cui.core.{Theme, UiContext}
+
+/* Toast 交互（缺口 #14）：点击关闭、事件不穿透、悬停暂停。 */
+/* 空画布后端：让 draw 不因无渲染设备抛异常（否则 rects 记录不到）。 */
+private class ToastNoopCanvas <: Canvas {
+    public func beginFrame(clear: Color): Unit {}
+    public func present(): Unit {}
+    public func captureTo(path: String): Int32 {
+        0
+    }
+    public func fill(rect: Rect, color: Color): Unit {}
+    public func fillRoundedRect(rect: Rect, radius: Float32, color: Color): Unit {}
+    public func fillRectGradient(rect: Rect, from: Color, to: Color, vertical: Bool): Unit {}
+    public func drawTextureRounded(id: Int64, destination: Rect, source: ?Rect, radius: Float32, alpha: Float32): Unit {}
+    public func fillRoundedRectSoft(rect: Rect, radius: Float32, color: Color, feather!: Float32): Unit {}
+    public func strokeRect(rect: Rect, pen: Pen): Unit {}
+    public func strokeRoundedRect(rect: Rect, radius: Float32, pen: Pen): Unit {}
+    public func strokeLine(x1: Float32, y1: Float32, x2: Float32, y2: Float32, pen: Pen): Unit {}
+    public func line(x1: Float32, y1: Float32, x2: Float32, y2: Float32, color: Color): Unit {}
+    public func fillCircle(cx: Float32, cy: Float32, radius: Float32, color: Color): Unit {}
+    public func strokeCircle(cx: Float32, cy: Float32, radius: Float32, pen: Pen, segments!: Int64): Unit {}
+    public func drawTexture(id: Int64, destination: Rect, source: ?Rect, alpha: Float32): Unit {}
+    public func uploadTexture(id: Int64, width: Int32, height: Int32, pixels: Array<UInt8>): Unit {}
+    public func uploadTexturePng(id: Int64, bytes: Array<UInt8>): Unit {}
+    public func releaseTexture(id: Int64): Unit {}
+    public func pushClip(rect: Rect): Unit {}
+    public func popClip(): Unit {}
+    public func text(text: String, x: Float32, y: Float32, color: Color, pointSize!: Float32): Unit {}
+    public func textWidth(text: String, pointSize!: Float32): Float32 {
+        0.0
+    }
+    public func textHeight(pointSize!: Float32): Float32 {
+        0.0
+    }
+    public func textCenter(text: String, rect: Rect, color: Color, pointSize!: Float32): Unit {}
+}
+
+private func toastIctx(): UiContext {
+    let renderer = Renderer.headless()
+    renderer.useBackend(ToastNoopCanvas())
+    let ctx = UiContext(renderer, Theme.light())
+    ctx.viewportWidth = 800.0
+    ctx.viewportHeight = 600.0
+    ctx
+}
+
+/*
+ * toast 常驻位置：右下角，宽 320、高 46、边距 16 → rect(464, 538, 320, 46)。
+ * 需先 draw 一次让 layer 记录本帧矩形（命中测试依赖绘制结果）。
+ */
+@Test
+func toastClickDismissesAndConsumesEvent(): Unit {
+    let ctx = toastIctx()
+    let toaster = Toaster()
+    toaster.show("boom", kind: ToastKind.Error, durationMs: 60000)
+    let layer = ToastLayer(toaster)
+    layer.draw(ctx)
+
+    @Expect(toaster.count(), 1)
+    // 入场滑动完成后（age ≥ 150ms）toast 落在最终位置 rect(464, 538, 320, 46)。
+    let _ = layer.handle(ctx, UiEvent.Frame(FrameInfo(UInt64(200), UInt64(200))))
+    layer.draw(ctx)
+    // 点击 toast 中心：事件被消费、该条关闭。
+    @Expect(layer.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 600.0, 560.0)))
+    @Expect(toaster.count(), 0)
+
+    // 点击空白区（无 toast）：不消费、事件下传。
+    @Expect(!layer.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, 100.0)))
+}
+
+@Test
+func toastPointerEventsDoNotFallThrough(): Unit {
+    let ctx = toastIctx()
+    let toaster = Toaster()
+    toaster.show("hold", durationMs: 60000)
+    let layer = ToastLayer(toaster)
+    layer.draw(ctx)
+
+    // 入场完成后按下在 toast 上被消费——底层控件不会再收到这次点击。
+    let _ = layer.handle(ctx, UiEvent.Frame(FrameInfo(UInt64(200), UInt64(200))))
+    layer.draw(ctx)
+    @Expect(layer.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 600.0, 560.0)))
+    layer.draw(ctx) // 关闭后矩形清空：抬起在原位置的空白区不再消费
+    @Expect(!layer.handle(ctx, UiEvent.MouseUp(MouseButton.Left, 600.0, 560.0)))
+}
+
+@Test
+func toastHoverPausesCountdown(): Unit {
+    let ctx = toastIctx()
+    let toaster = Toaster()
+    toaster.show("read me", durationMs: 1000)
+    let layer = ToastLayer(toaster)
+    layer.draw(ctx)
+
+    // 入场完成后悬停在 toast 上 → 冻结：寿命不再减少。
+    let _ = layer.handle(ctx, UiEvent.Frame(FrameInfo(UInt64(200), UInt64(200))))
+    layer.draw(ctx)
+    @Expect(!layer.handle(ctx, UiEvent.MouseMove(600.0, 560.0))) // move 不消费
+    toaster.tick(800)
+    @Expect(toaster.count(), 1) // 冻结中，寿命没扣
+
+    // 移开 → 解冻：继续计时直至到期。
+    let _ = layer.handle(ctx, UiEvent.MouseMove(100.0, 100.0))
+    toaster.tick(800)
+    @Expect(toaster.count(), 0)
+}
+
+@Test
+func toasterDismissIsIdempotent(): Unit {
+    let toaster = Toaster()
+    toaster.show("once", durationMs: 60000)
+    let first = toaster.snapshot()[0]
+    @Expect(toaster.dismiss(first.id)) // 第一次关闭成功
+    @Expect(!toaster.dismiss(first.id)) // 第二次：已不在，返回 false
+    @Expect(toaster.count(), 0)
+}
