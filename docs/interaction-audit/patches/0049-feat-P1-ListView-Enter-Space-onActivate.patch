@@ -164,9 +167,21 @@ public class ListView <: Widget {
         // Shift 区间选择的锚点（缺口 #9）：普通点击时重置为点击项，Shift+点击时保持——
         // 两次的区间即选中范围。localState 保证跨重建保留。
         this.selectionAnchor = localState<Int64>("${cid}:anchor") {Int64.Min}
+        this.onActivate = onActivate
         emit(this)
     }
 
+    // 触发激活回调（索引钳到有效范围；无回调或空列表时是 no-op）。
+    private func fireActivate(index: Int64): Unit {
+        match (onActivate) {
+            case Some(action) =>
+                if (index >= 0 && index < items.size) {
+                    action(index)
+                }
+            case None => ()
+        }
+    }
+
     /** Uses an externally owned scroll offset, enabling restoration and coordination. */
     public func scrollState(value: State<Float32>): ListView {
         scrollStateValue = value
@@ -230,6 +245,10 @@ public class ListView <: Widget {
                         let idx = Int64((y - viewport.y + scrollMotion.value) / CUI_SMALL_H)
                         if (idx >= 0 && idx < items.size) {
                             applySelection(idx, Keyboard.modifiers().shift)
+                            // 双击行 = 激活（打开/进入）：桌面列表的通行语义。
+                            if (ctx.clickCount == 2) {
+                                fireActivate(idx)
+                            }
                         }
                     }
                     return true
@@ -248,6 +267,18 @@ public class ListView <: Widget {
             case UiEvent.KeyDown(Key.Down, shift) => return extendOrMove(ctx, 1, shift)
             case UiEvent.KeyDown(Key.Home, shift) => return extendOrJump(ctx, 0, shift)
             case UiEvent.KeyDown(Key.End, shift) => return extendOrJump(ctx, items.size - 1, shift)
+            // 激活（键盘等价物）：聚焦后 Enter/Space 触发当前选中项的 onActivate——
+            // 与双击同一回调，键盘用户获得相同的"打开"能力。
+            case UiEvent.KeyDown(Key.Enter, _) =>
+                if (ctx.hasFocus(controlId) && onActivate.isSome()) {
+                    fireActivate(selected.value)
+                    return true
+                }
+            case UiEvent.KeyDown(Key.Space, _) =>
+                if (ctx.hasFocus(controlId) && onActivate.isSome()) {
+                    fireActivate(selected.value)
+                    return true
+                }
             case _ => ()
         }
         false
