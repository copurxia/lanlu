+++ b/src/controls/list_activate_test.cj
@@ -0,0 +1,57 @@
+// 激活语义（onActivate）：双击 / Enter / Space。
+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+private func actContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/* 激活语义：双击行 = 打开；聚焦后 Enter/Space = 同一回调；未设置回调时行为不变。 */
+@Test
+func doubleClickRowFiresActivate(): Unit {
+    let ctx = actContext()
+    let selected = State<Int64>(0)
+    let fired = State<Int64>(-1)
+    let list = ListView(["a", "b", "c"], selected, key: "ac.dbl", onActivate: {i => fired.value = i})
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+
+    // 第一次按下（clickCount=1）：只选中。
+    ctx.recordPress(100.0, Float32(1.5 * 28.0))
+    @Expect(list.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, Float32(1.5 * 28.0))))
+    @Expect(fired.value, Int64(-1))
+
+    // 第二次按下（clickCount=2）：选中 + 激活第 1 行。
+    ctx.recordPress(100.0, Float32(1.5 * 28.0))
+    let _ = list.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, Float32(1.5 * 28.0)))
+    @Expect(fired.value, Int64(1))
+}
+
+@Test
+func enterKeyFiresActivateOnSelected(): Unit {
+    let ctx = actContext()
+    let selected = State<Int64>(2)
+    let fired = State<Int64>(-1)
+    let list = ListView(["a", "b", "c"], selected, key: "ac.kbd", onActivate: {i => fired.value = i})
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+    ctx.focus("ac.kbd", viaKeyboard: true)
+
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(fired.value, Int64(2))
+
+    // Space 同样激活。
+    @Expect(list.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(fired.value, Int64(2))
+}
+
+@Test
+func listWithoutActivateCallbackIgnoresEnter(): Unit {
+    let ctx = actContext()
+    let selected = State<Int64>(0)
+    let list = ListView(["a", "b"], selected, key: "ac.none")
+    list.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+    ctx.focus("ac.none", viaKeyboard: true)
+    // 未设置回调：Enter 不被消费（与既有行为一致）。
+    @Expect(!list.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+}
