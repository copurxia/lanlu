@@ -334,8 +338,12 @@ public class Table <: Widget {
     }
 
     private func drawRow(ctx: UiContext, rowIndex: Int64, displayPos: Int64, rowRect: Rect): Unit {
+        let inRange = selectionAnchor.value != Int64.Min && rangeContains(rowIndex)
         if (rowIndex == selected.value) {
             ctx.renderer.fillRoundedRect(rowRect.inset(1.0), ctx.theme.smallRadius, ctx.theme.accentSoft)
+        } else if (inRange) {
+            // Shift 区间（缺口 #9 表格版）：区间内其它行用更淡的 accent 底，和单选行区分。
+            ctx.renderer.fillRoundedRect(rowRect.inset(1.0), ctx.theme.smallRadius, ctx.theme.accentSoft.withAlpha(90))
