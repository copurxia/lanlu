-    private func moveSelection(ctx: UiContext, delta: Int64): Bool {
+    private func moveSelection(ctx: UiContext, delta: Int64, keepAnchor: Bool): Bool {
         if (!ctx.hasFocus(id) || rows.isEmpty()) {
             return false
         }
         let order = displayOrder()
-        selectDisplay(order, clampPosition(displayPositionOf(order, selected.value) + delta, order.size))
+        selectDisplay(order, clampPosition(displayPositionOf(order, selected.value) + delta, order.size),
+            keepAnchor)
         true
     }
 
-    private func setSelectionToDisplay(ctx: UiContext, pos: Int64): Bool {
+    private func setSelectionToDisplay(ctx: UiContext, pos: Int64, keepAnchor: Bool): Bool {
         if (!ctx.hasFocus(id) || rows.isEmpty()) {
             return false
         }
         let order = displayOrder()
-        selectDisplay(order, clampPosition(pos, order.size))
+        selectDisplay(order, clampPosition(pos, order.size), keepAnchor)
         true
     }
 
-    // Selects the row at a display position and scrolls it into view.
-    private func selectDisplay(order: Array<Int64>, pos: Int64): Unit {
+    // 原始行索引是否落在当前 Shift 区间内（按显示序判断）。
+    private func rangeContains(rowIndex: Int64): Bool {
+        let order = displayOrder()
+        let from = clampPosition(min(displayPositionOf(order, selectionAnchor.value),
+            displayPositionOf(order, selected.value)), order.size)
+        let to = clampPosition(max(displayPositionOf(order, selectionAnchor.value),
+            displayPositionOf(order, selected.value)), order.size)
+        let pos = displayPositionOf(order, rowIndex)
+        pos >= from && pos <= to
+    }
+
+    /** 当前 Shift 区间（原始行索引，含两端）；无锚点时退化为单点。表格按显示序操作，区间按显示序展开后取原始索引。 */
+    public func selectionRange(): Array<Int64> {
+        let order = displayOrder()
+        let anchor = selectionAnchor.value
+        if (anchor == Int64.Min || order.isEmpty()) {
+            return [selected.value]
+        }
+        let from = clampPosition(min(displayPositionOf(order, anchor), displayPositionOf(order, selected.value)), order.size)
+        let to = clampPosition(max(displayPositionOf(order, anchor), displayPositionOf(order, selected.value)), order.size)
+        let picked = ArrayList<Int64>()
+        var i = from
+        while (i <= to) {
+            picked.add(order[i])
+            i += 1
+        }
+        picked.toArray()
+    }
+
+    // Selects the row at a display position and scrolls it into view. keepAnchor: Shift 扩展
+    // （保持锚点，无锚点时以当前选中项起锚）；普通选择把锚点移到新位置。
+    private func selectDisplay(order: Array<Int64>, pos: Int64, keepAnchor: Bool): Unit {
         if (pos < 0 || pos >= order.size) {
             return
         }
+        if (keepAnchor) {
+            if (selectionAnchor.value == Int64.Min) {
+                selectionAnchor.value = selected.value
+            }
+        } else {
+            selectionAnchor.value = order[pos]
+        }
         selected.value = order[pos]
         revealPosition(pos)
     }
