+    // 焦点在面包屑上时，当前键盘段（无焦点时落在首个可点击段）。
+    private func crumbStep(ctx: UiContext, delta: Int64): Bool {
+        if (!ctx.hasFocus(id) || onSelect.isNone()) {
+            return false
+        }
+        let links = clickableIndices()
+        if (links.size == 0) {
+            return false
+        }
+        // 未定（-1）视为指向首个链接段；否则在链接列表中找当前位置。
+        var pos = 0
+        let currentIdx = keyboardIdx.value
+        if (currentIdx >= 0) {
+            for (i in 0..links.size) {
+                if (links[i] == currentIdx) {
+                    pos = i
+                }
+            }
+        } else if (delta < 0) {
+            pos = links.size - 1 // 从"未定"向左：落到最后一个链接段
+        }
+        let next = clampInt(pos + delta, 0, links.size - 1)
+        keyboardIdx.value = links[next]
+        return true
+    }
