+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{Bindable, State, Theme, UiContext}
+
+private func navTestContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+// Pagination：不可聚焦 → 可聚焦 + Left/Right 翻页（P0-3）。
+@Test
+func paginationFocusesAndStepsWithArrows(): Unit {
+    let ctx = navTestContext()
+    let page = State<Int64>(2)
+    let pager = Pagination(5, page, key: "nav.pager")
+    pager.layout(ctx, Rect(0.0, 0.0, 300.0, 34.0))
+    @Expect(!ctx.hasFocus("nav.pager"))
+
+    @Expect(!pager.handle(ctx, UiEvent.KeyDown(Key.Right, false))) // 未聚焦不消费
+    @Expect(page.value, Int64(2))
+
+    // 点击聚焦（点在 prev 箭头上，必中；注意箭头本身会翻页：2 → 1），随后方向键翻页。
+    @Expect(pager.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 17.0, 17.0)))
+    @Expect(ctx.hasFocus("nav.pager"))
+    @Expect(page.value, Int64(1)) // prev 箭头已把 2 翻到 1
+
+    @Expect(pager.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(page.value, Int64(2))
+    @Expect(pager.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(page.value, Int64(1))
+}
+
+@Test
+func paginationKeyboardArrowsClampAtEnds(): Unit {
+    let ctx = navTestContext()
+    let page = State<Int64>(4)
+    let pager = Pagination(5, page, key: "nav.clamp")
+    pager.layout(ctx, Rect(0.0, 0.0, 300.0, 34.0))
+    // 从末页 4 出发：prev 箭头翻到 3，随后 Right 又回到 4 并被收住。
+    let _ = pager.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 17.0, 17.0))
+    @Expect(page.value, Int64(3))
+    @Expect(pager.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(page.value, Int64(4)) // 末页不越界
+}
+
+// Breadcrumb：可点击时进焦点环、Left/Right 移动、Enter/Space 激活；纯展示不进环。
+@Test
+func breadcrumbKeyboardWalksAndActivates(): Unit {
+    let ctx = navTestContext()
+    let picked = State<Int64>(-1)
+    let trail = Breadcrumb(["首页", "文档", "项目"], onSelect: {i => picked.value = i}, key: "nav.crumb")
+    trail.layout(ctx, Rect(0.0, 0.0, 400.0, 28.0))
+    @Expect(trail.focusableId().isSome()) // 可点击面包屑进焦点环
+    // 点击首个链接段（"首页"，宽约 textWidth+14）获得焦点——键盘导航从这里开始。
+    @Expect(trail.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 12.0, 14.0)))
+    @Expect(ctx.hasFocus("nav.crumb"))
+
+    // 初始键盘段未定（-1）：Right 落到首个链接段 0（"首页"），再 Right → 1（"文档"）。Enter 激活。
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(picked.value, 1)
+
+    // Right 在最后一个链接段被收住（当前位置"项目"不是链接，不在列表里）。
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    let _ = trail.handle(ctx, UiEvent.KeyDown(Key.Enter, false))
+    @Expect(picked.value, 1) // 仍是 1：Right 没有越界到别的段
+
+    // Left 回到 0（"首页"），Space 同样激活。
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(trail.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(picked.value, 0)
+}
+
+@Test
+func breadcrumbDisplayOnlyStaysOutOfFocusRing(): Unit {
+    let ctx = navTestContext()
+    let trail = Breadcrumb(["a", "b"], key: "nav.plain")
+    trail.layout(ctx, Rect(0.0, 0.0, 120.0, 28.0))
+    @Expect(trail.focusableId().isNone()) // 纯展示面包屑不是焦点停靠点
+    @Expect(!trail.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+}
+
+// StepIndicator：可选择时进焦点环、Left/Right/Enter/Space；纯指示器不进环。
+@Test
+func stepIndicatorKeyboardWalksAndActivates(): Unit {
+    let ctx = navTestContext()
+    let picked = State<Int64>(-1)
+    let steps = StepIndicator(["注册", "付款", "完成"], 1, onSelect: {i => picked.value = i}, key: "nav.steps")
+    steps.layout(ctx, Rect(0.0, 0.0, 400.0, 60.0))
+    @Expect(steps.focusableId().isSome())
+    // 点击已到达步（step 0 的节点中心）获得焦点。measure 后 xs[0] = 44+14 = 58?（EDGE_PAD=44，
+    // 圆心在 x=44+…；用 3 步均分：left=44, right=356, gap=156 → xs[0]=44）
+    @Expect(steps.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 44.0, 18.0)))
+    @Expect(ctx.hasFocus("nav.steps"))
+
+    // 点击已把键盘步定到 0；Right → 1；再 Right 收住仍 1；Enter 激活 1。
+    @Expect(steps.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(steps.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(steps.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(picked.value, 1)
+
+    // Left → 0，Space 激活 0。
+    @Expect(steps.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(steps.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(picked.value, 0)
+}
+
+@Test
+func stepIndicatorDisplayOnlyIgnoresKeyboard(): Unit {
+    let ctx = navTestContext()
+    let steps = StepIndicator(["a", "b"], 1, key: "nav.plainsteps")
+    steps.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+    @Expect(steps.focusableId().isNone())
+    @Expect(!steps.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+}
