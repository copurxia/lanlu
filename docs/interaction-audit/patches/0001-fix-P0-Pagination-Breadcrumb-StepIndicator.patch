+package cui.text
+
+import lgui.{Canvas, Color, MouseButton, Pen, Rect, Renderer, UiEvent}
+import std.collection.ArrayList
+import cui.core.{State, Theme, UiContext}
+
+/*
+ * 记录型画布：把 drawSurface / drawFocusRing 真正用到的两类图元记下来（圆角填充色、
+ * 圆角描边色 + 线宽 + 半径），其余图元空实现。这样测试不依赖真实渲染设备，
+ * 也能断言输入框 chrome 的激活态与键盘外环——这是本机（无 GPU/SDL 设备）唯一可观测的路径。
+ */
+class ChromeProbe <: Canvas {
+    let fills: ArrayList<Color> = ArrayList<Color>()
+    let strokeColors: ArrayList<Color> = ArrayList<Color>()
+    let strokeWidths: ArrayList<Float32> = ArrayList<Float32>()
+    let strokeRadii: ArrayList<Float32> = ArrayList<Float32>()
+
+    public func reset(): Unit {
+        fills.clear()
+        strokeColors.clear()
+        strokeWidths.clear()
+        strokeRadii.clear()
+    }
+
+    private func recordPen(pen: Pen): Unit {
+        strokeColors.add(pen.color)
+        strokeWidths.add(pen.width)
+    }
+
+    public func beginFrame(clear: Color): Unit {}
+    public func present(): Unit {}
+    public func captureTo(path: String): Int32 {
+        0
+    }
+    public func fill(rect: Rect, color: Color): Unit {
+        fills.add(color)
+    }
+    public func fillRoundedRect(rect: Rect, radius: Float32, color: Color): Unit {
+        fills.add(color)
+    }
+    public func fillRectGradient(rect: Rect, from: Color, to: Color, vertical: Bool): Unit {}
+    public func drawTextureRounded(id: Int64, destination: Rect, source: ?Rect, radius: Float32, alpha: Float32): Unit {}
+    public func fillRoundedRectSoft(rect: Rect, radius: Float32, color: Color, feather!: Float32): Unit {
+        // 阴影也是 chrome 可观测的一部分：记录颜色即可区分激活态（有 accent 光晕）与常态（无）。
+        fills.add(color)
+    }
+    public func strokeRect(rect: Rect, pen: Pen): Unit {
+        recordPen(pen)
+    }
+    public func strokeRoundedRect(rect: Rect, radius: Float32, pen: Pen): Unit {
+        recordPen(pen)
+        strokeRadii.add(radius)
+    }
+    public func strokeLine(x1: Float32, y1: Float32, x2: Float32, y2: Float32, pen: Pen): Unit {
+        recordPen(pen)
+    }
+    public func line(x1: Float32, y1: Float32, x2: Float32, y2: Float32, color: Color): Unit {}
+    public func fillCircle(cx: Float32, cy: Float32, radius: Float32, color: Color): Unit {}
+    public func strokeCircle(cx: Float32, cy: Float32, radius: Float32, pen: Pen, segments!: Int64): Unit {}
+    public func drawTexture(id: Int64, destination: Rect, source: ?Rect, alpha: Float32): Unit {}
+    public func uploadTexture(id: Int64, width: Int32, height: Int32, pixels: Array<UInt8>): Unit {}
+    public func uploadTexturePng(id: Int64, bytes: Array<UInt8>): Unit {}
+    public func pushClip(rect: Rect): Unit {}
+    public func popClip(): Unit {}
+    public func text(text: String, x: Float32, y: Float32, color: Color, pointSize!: Float32): Unit {}
+    public func textWidth(text: String, pointSize!: Float32): Float32 {
+        0.0
+    }
+    public func textHeight(pointSize!: Float32): Float32 {
+        0.0
+    }
+    public func textCenter(text: String, rect: Rect, color: Color, pointSize!: Float32): Unit {}
+
+    public func hasFill(color: Color): Bool {
+        for (c in fills) {
+            if (c == color) {
+                return true
+            }
+        }
+        false
+    }
+
+    public func hasStroke(color: Color, width: Float32): Bool {
+        for (i in 0..strokeColors.size) {
+            if (strokeColors[i] == color && strokeWidths[i] == width) {
+                return true
+            }
+        }
+        false
+    }
+
+    public func strokeCount(): Int64 {
+        strokeColors.size
+    }
+}
+
+private func chromeContext(): (UiContext, ChromeProbe) {
+    let probe = ChromeProbe()
+    let renderer = Renderer.headless()
+    renderer.useBackend(probe)
+    (UiContext(renderer, Theme.dark()), probe)
+}
+
+private let FOCUS_RING_WIDTH: Float32 = 1.6
+
+/*
+ * 用户反馈的那条：点击输入框必须出现可见的激活态（accent 边 + fieldActive 底），
+ * 而不是只有光标在闪。此前 chrome 读 showFocusRing，指针聚焦时整框纹丝不动。
+ */
+@Test
+func pointerFocusPaintsActiveFieldChrome(): Unit {
+    let (ctx, probe) = chromeContext()
+    let body = State<String>("abc")
+    let field = TextField(body, key: "chrome.field")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 32.0))
+    @Expect(field.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 10.0, 10.0)))
+    @Expect(ctx.hasFocus("chrome.field"))
+    @Expect(!ctx.showFocusRing("chrome.field")) // 指针聚焦：键盘外环仍不画
+
+    probe.reset()
+    field.draw(ctx)
+    let active = ctx.theme.fieldSurface(true)
+    let idle = ctx.theme.fieldSurface(false)
+    @Expect(probe.hasFill(active.fill)) // 底色切到 fieldActive
+    @Expect(!probe.hasFill(idle.fill)) // 不再是常态底色
+    @Expect(probe.hasStroke(active.border, active.borderWidth)) // 1px accent 边
+    @Expect(!probe.hasStroke(ctx.theme.accent, FOCUS_RING_WIDTH)) // 外环留给键盘
+}
+
+@Test
+func keyboardFocusAddsRingOnTopOfActiveChrome(): Unit {
+    let (ctx, probe) = chromeContext()
+    let body = State<String>("")
+    let field = TextField(body, key: "chrome.kbd")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 32.0))
+    ctx.focus("chrome.kbd", viaKeyboard: true)
+    @Expect(ctx.showFocusRing("chrome.kbd"))
+
+    probe.reset()
+    field.draw(ctx)
+    let active = ctx.theme.fieldSurface(true)
+    @Expect(probe.hasFill(active.fill))
+    @Expect(probe.hasStroke(active.border, active.borderWidth)) // 激活边仍在
+    @Expect(probe.hasStroke(ctx.theme.accent, FOCUS_RING_WIDTH)) // Tab 到达：叠外环
+}
+
+@Test
+func unfocusedFieldKeepsIdleChrome(): Unit {
+    let (ctx, probe) = chromeContext()
+    let body = State<String>("abc")
+    let field = TextField(body, key: "chrome.idle")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 32.0))
+    ctx.clearFocus()
+
+    probe.reset()
+    field.draw(ctx)
+    let idle = ctx.theme.fieldSurface(false)
+    let active = ctx.theme.fieldSurface(true)
+    @Expect(probe.hasFill(idle.fill))
+    @Expect(!probe.hasFill(active.fill))
+    @Expect(probe.hasStroke(idle.border, idle.borderWidth))
+    @Expect(!probe.hasStroke(ctx.theme.accent, FOCUS_RING_WIDTH))
+}
+
+@Test
+func textAreaSharesTheSameActivationPolicy(): Unit {
+    let (ctx, probe) = chromeContext()
+    let body = State<String>("line")
+    let area = TextArea(body, key: "chrome.area")
+    area.layout(ctx, Rect(0.0, 0.0, 240.0, 96.0))
+    @Expect(area.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 12.0, 12.0)))
+    @Expect(ctx.hasFocus("chrome.area"))
+    @Expect(!ctx.showFocusRing("chrome.area"))
+
+    probe.reset()
+    area.draw(ctx)
+    let active = ctx.theme.fieldSurface(true)
+    @Expect(probe.hasFill(active.fill))
+    @Expect(probe.hasStroke(active.border, active.borderWidth))
+    @Expect(!probe.hasStroke(ctx.theme.accent, FOCUS_RING_WIDTH))
+}
