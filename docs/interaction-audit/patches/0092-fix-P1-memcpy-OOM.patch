 src/media/pixel_side_limit_test.cj | 41 ++++++++++++++++++++++++++++++
 src/media/pixel_texture_cache.cj   | 19 +++++++++++---
 2 files changed, 56 insertions(+), 4 deletions(-)
 create mode 100644 src/media/pixel_side_limit_test.cj

diff --git a/src/media/pixel_side_limit_test.cj b/src/media/pixel_side_limit_test.cj
new file mode 100644
index 0000000..08916fb
--- /dev/null
+++ b/src/media/pixel_side_limit_test.cj
@@ -0,0 +1,41 @@
+package cui.media
+
+import lgui.Renderer
+
+/*
+ * 单边尺寸上限：超过上限的尺寸必须在**拷贝像素之前**拒绝。textureFromNativeRgba 会先按
+ * width*height*4 做一次 memcpy——荒唐尺寸（解码器给错值）会 OOM/崩溃，而不是走正常的
+ * "纹理创建失败"路径。这里验证：超限尺寸登记后 staged 字节保持为 0。
+ */
+private func stagedNow(): Int64 {
+    let (staged, _, _, _) = pixelCacheDiagnostics()
+    staged
+}
+
+@Test
+func oversizedSideIsRejectedBeforeCopy(): Unit {
+    clearPixelImages()
+    let saved = pixelMaxImageSide
+    pixelMaxImageSide = 64
+    // 65×1 超过上限：拒绝（即便像素长度看起来合法）。
+    stagePixelImage("side.big", 65, 1, Array<UInt8>(65 * 4, repeat: 0))
+    @Expect(stagedNow(), Int64(0))
+    // 64×1 恰好等于上限：接受。
+    stagePixelImage("side.ok", 64, 1, Array<UInt8>(64 * 4, repeat: 0))
+    @Expect(stagedNow(), Int64(64 * 4))
+    pixelMaxImageSide = saved
+    clearPixelImages()
+}
+
+@Test
+func oversizedSideOnRegisterIsRejected(): Unit {
+    clearPixelImages()
+    let saved = pixelMaxImageSide
+    pixelMaxImageSide = 64
+    let renderer = Renderer.headless()
+    registerPixelImage(renderer, "side.reg.big", 65, 1, Array<UInt8>(65 * 4, repeat: 0))
+    let (_, texture, _, _) = pixelCacheDiagnostics()
+    @Expect(texture, Int64(0))
+    pixelMaxImageSide = saved
+    clearPixelImages()
+}
diff --git a/src/media/pixel_texture_cache.cj b/src/media/pixel_texture_cache.cj
index 210baff..b2f9fc2 100644
--- a/src/media/pixel_texture_cache.cj
+++ b/src/media/pixel_texture_cache.cj
@@ -142,6 +142,11 @@ public var onPixelImageEvicted: ?(String) -> Unit = None
 // 触发一次重解码。默认 None（不回调）。
 public var onPixelImageRejected: ?(String, String) -> Unit = None
 
+// 单边尺寸上限：GPU 纹理常见的最大边长是 16384。超过它的尺寸**在拷贝像素之前**就必须拒绝——
+// textureFromNativeRgba 会先按 width*height*4 做一次 memcpy，荒唐尺寸（解码器给错值）会直接
+// OOM/崩溃，而不是走"创建失败"的正常错误路径。可按需调高（受具体后端限制）。
+public var pixelMaxImageSide: Int32 = 16384
+
 // UI 每帧纹理上传预算（P1.6 流水线第 3 级）：以 16ms 时间窗近似一帧，超预算的上传
 // 顺延下一帧，避免多张图同时到货在同一帧集中上传导致卡顿。0 = 不限额。
 public var pixelUploadBudgetBytes: Int64 = 16 * 1024 * 1024
@@ -153,6 +158,11 @@ private var uploadWindowStart = MonoTime.now()
 // 单张图大于整帧预算时必须放行一次：窗口重置后 uploadedThisWindow 归零，"0 + bytes > 预算"
 // 恒为真，会让这张图**每帧都被拒**——表现为该图永远空白（高清封面就是这种尺寸）。
 // 放行后照常累加，同一窗口内的其余上传仍被节流到下一帧。
+// 尺寸是否可用（正数且不超过单边上限）。超过上限时在拷贝像素前拒绝，避免 memcpy 巨大尺寸。
+private func usablePixelSize(width: Int32, height: Int32): Bool {
+    width > 0 && height > 0 && width <= pixelMaxImageSide && height <= pixelMaxImageSide
+}
+
 // 拒绝登记时统一回调（见 onPixelImageRejected）。
 private func notifyRejected(key: String, reason: String): Unit {
     match (onPixelImageRejected) {
@@ -315,7 +325,7 @@ public func stagePixelImage(key: String, width: Int32, height: Int32, pixels: Ar
     // 尺寸与字节数校验（解码输入不可信）：width/height 非正、或长度不等于 width*height*4 时
     // 直接拒绝登记。否则上传路径会按 width*height*4 读取像素数组，越界读产出花屏/崩溃——
     // 表现为"封面空白或花块"而非明确报错。
-    if (width <= 0 || height <= 0 || Int64(pixels.size) != pixelBytesOf(width, height)) {
+    if (!usablePixelSize(width, height) || Int64(pixels.size) != pixelBytesOf(width, height)) {
         notifyRejected(key, "size " + width.toString() + "x" + height.toString() + " needs " +
             pixelBytesOf(width, height).toString() + " bytes, got " + pixels.size.toString())
         return
@@ -340,11 +350,12 @@ public func stageNativePixelImage(key: String, width: Int32, height: Int32, poin
     releaser: PixelReleaser): Unit {
     // 尺寸校验：非正尺寸的原生图登记后会在上传时建 0 尺寸纹理（永远画不出来）。
     // 所有权已随调用转移到这里，因此拒绝时必须**自己**用 releaser 释放，否则泄漏。
-    if (width <= 0 || height <= 0) {
+    if (!usablePixelSize(width, height)) {
         // 先释放再回调：回调是应用代码，万一下面通知里抛异常，所有权也已经归还，
         // 不会因为"通知失败"而泄漏原生像素。
         releaser.release()
-        notifyRejected(key, "non-positive size " + width.toString() + "x" + height.toString())
+        notifyRejected(key, "unusable size " + width.toString() + "x" + height.toString() +
+            " (limit " + pixelMaxImageSide.toString() + ")")
         return
     }
     removeTextureEntry(key)
@@ -366,7 +377,7 @@ public func registerPixelImage(renderer: Renderer, key: String, width: Int32, he
     pixels: Array<UInt8>): Unit {
     // 与 stagePixelImage 同一道校验：登记/原地更新都会按 width*height*4 读像素数组，
     // 长度不符即越界读（解码输入不可信）。非正尺寸还会建 0 尺寸纹理。
-    if (width <= 0 || height <= 0 || Int64(pixels.size) != pixelBytesOf(width, height)) {
+    if (!usablePixelSize(width, height) || Int64(pixels.size) != pixelBytesOf(width, height)) {
         notifyRejected(key, "size " + width.toString() + "x" + height.toString() + " needs " +
             pixelBytesOf(width, height).toString() + " bytes, got " + pixels.size.toString())
         return
