符号级扫描发现的第二个零测试控件。补两例：
- measure 占满可用空间；draw 把布局后的 frame 交给回调；
- onEvent 回调被调用且返回 false = 不消费（继续传父层）。

cjpm test：TOTAL 535 / PASSED 528，基线匹配零回归。
---
 src/media/canvas_widget_test.cj | 36 +++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 src/media/canvas_widget_test.cj

diff --git a/src/media/canvas_widget_test.cj b/src/media/canvas_widget_test.cj
new file mode 100644
index 0000000..92c1764
--- /dev/null
+++ b/src/media/canvas_widget_test.cj
@@ -0,0 +1,36 @@
+package cui.media
+
+import lgui.{Key, Rect, Renderer, Size, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+/*
+ * CanvasWidget 基础契约：占满可用空间度量；draw 把 frame 交给回调（裁剪在回调外圈）；
+ * onEvent 回调可替换并按 frame 判定消费；未命中返回 false。
+ */
+@Test
+func canvasWidgetFillsSpaceAndPassesFrameToDraw(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let seenW = State<Float32>(0.0)
+    let canvas = CanvasWidget({_, rect => seenW.value = rect.w})
+    let m = canvas.measure(ctx, Size(240.0, 120.0))
+    @Expect(m.w, Float32(240.0)) // 占满可用空间
+    @Expect(m.h, Float32(120.0))
+    canvas.layout(ctx, Rect(0.0, 0.0, 240.0, 120.0))
+    canvas.draw(ctx) // headless：fill/clip 会走 no-op 后端，回调拿到 frame
+    @Expect(seenW.value, Float32(240.0))
+}
+
+@Test
+func canvasWidgetEventReceivesFrameAndMayConsume(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let hit = State<Bool>(false)
+    let canvas = CanvasWidget({_, _ => ()},
+        onEvent: {_, rect =>
+            // 事件回调拿到的是布局后的 frame；这里以"回调被调用"为断言基础。
+            hit.value = true
+            false})
+    canvas.layout(ctx, Rect(0.0, 0.0, 100.0, 50.0))
+    let consumed = canvas.handle(ctx, UiEvent.KeyDown(Key.Enter, false))
+    @Expect(hit.value)     // 回调确实被调用
+    @Expect(!consumed)     // 返回 false = 不消费（继续传给父层）
+}
