 1 file changed, 29 insertions(+)
 create mode 100644 src/core/binding_test.cj

diff --git a/src/core/binding_test.cj b/src/core/binding_test.cj
new file mode 100644
index 0000000..aaf2327
--- /dev/null
+++ b/src/core/binding_test.cj
@@ -0,0 +1,29 @@
+package cui.core
+
+/*
+ * Binding（Bindable.project）此前无测试——它是双向投影的状态原语：读委托源、写回源
+ * 重建整值，保证"唯一真相源"。应用的表单/设置页正依赖这一语义。
+ */
+@Test
+func projectedBindingReadsAndWritesThroughSource(): Unit {
+    let source = State<Int64>(10)
+    // 投影：读时翻倍，写时折半回写源。
+    let doubled = source.project(get: {v => v * 2}, set: {_, v => v / 2})
+    @Expect(doubled.value, Int64(20))
+    doubled.value = 42
+    @Expect(source.value, Int64(21)) // 写回源
+    @Expect(doubled.value, Int64(42)) // 再读投影
+}
+
+@Test
+func projectedBindingObservesSourceChanges(): Unit {
+    let source = State<Int64>(10)
+    let doubled = source.project(get: {v => v * 2}, set: {_, v => v / 2})
+    let seen = State<Int64>(0)
+    let observation = doubled.observe({old, next => seen.value = next - old})
+    doubled.value = 42 // 源变 21 → 投影 20 → 42
+    @Expect(source.value, Int64(21))
+    @Expect(seen.value, Int64(22))
+    observation.close()
+    @Expect(observation.isClosed())
+}
