 src/media/pixel_image_view_test.cj | 36 ++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 src/media/pixel_image_view_test.cj

diff --git a/src/media/pixel_image_view_test.cj b/src/media/pixel_image_view_test.cj
new file mode 100644
index 0000000..552b955
--- /dev/null
+++ b/src/media/pixel_image_view_test.cj
@@ -0,0 +1,36 @@
+package cui.media
+
+import lgui.{Rect, Renderer, Size}
+import cui.core.{LengthUnits, Theme, UiContext}
+
+/*
+ * PixelImageView 的基础契约：按 preferredWidth/Height 度量（钳到可用空间），
+ * layout 记录 frame 供 draw 使用；zoom/rounded 修饰链返回自身；未注册的 key 绘制为空
+ * （不崩、不请求纹理）——封面路径的显示端。
+ */
+@Test
+func pixelImageViewMeasuresAndChainsModifiers(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let view = PixelImageView("k.none", 120.vp, 160.vp)
+    let m = view.measure(ctx, Size(300.0, 300.0))
+    @Expect(m.w, Float32(120.0))
+    @Expect(m.h, Float32(160.0))
+    // 修饰链返回自身（可继续链式调用）。
+    let _ = view.zoom(1.5).rounded(8.0)
+    // zoom 生效的旁证：过小的系数被钳到 0.01 下限（不会变成 0 尺寸）。
+    let _ = view.zoom(0.0)
+    @Expect(view.measure(ctx, Size(300.0, 300.0)).w, Float32(120.0))
+    view.layout(ctx, Rect(10.0, 20.0, 120.0, 160.0))
+    // 未注册 key：draw 不崩（无纹理 → 绘制为空）。
+    view.draw(ctx)
+    @Expect(true)
+}
+
+@Test
+func pixelImageViewClampsToAvailableSpace(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let view = PixelImageView("k.big", 500.vp, 500.vp)
+    let m = view.measure(ctx, Size(200.0, 100.0))
+    @Expect(m.w <= 200.0)
+    @Expect(m.h <= 100.0)
+}
