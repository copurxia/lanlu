上一提交修了 Table.of 不转发 onActivate 的问题；补测试把它钉住——否则以后新增构造
参数时很容易再漏。用例走工厂路径（抽取器写法）选中首行后按 Space，断言回调收到 0。

cjpm test：TOTAL 528 / PASSED 521，基线匹配零回归。
---
 src/controls/table_activate_test.cj | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/controls/table_activate_test.cj b/src/controls/table_activate_test.cj
index 45076be..b13bb69 100644
--- a/src/controls/table_activate_test.cj
+++ b/src/controls/table_activate_test.cj
@@ -53,3 +53,22 @@ func tableSpaceFallsBackToSortWithoutActivate(): Unit {
     let _ = tbl.handle(ctx, UiEvent.KeyDown(Key.Space, false))
     @Expect(true) // 到这里没崩即通过（排序状态是内部 State）
 }
+
+@Test
+func tableOfFactoryForwardsOnActivate(): Unit {
+    let ctx = tblCtx()
+    let activated = State<Int64>(-1)
+    // 工厂路径（抽取器写法）必须与主构造函数一样拿到行激活能力。
+    let tbl = Table.of<String>(
+        ["a", "b", "c"],
+        [DataColumn<String>("名称", 120.0, value: {v => v})],
+        State<Int64>(0),
+        key: "of.tbl",
+        onActivate: {i => activated.value = i}
+    )
+    tbl.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+    let _ = tbl.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, 40.0)) // 选中某行并聚焦
+    let _ = tbl.handle(ctx, UiEvent.KeyDown(Key.Space, false))
+    @Expect(activated.value, Int64(0)) // 选中行是 0（点在第一行）
+}
+
