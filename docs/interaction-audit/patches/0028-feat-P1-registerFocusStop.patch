+++ b/src/core/focus_stop_test.cj
@@ -0,0 +1,76 @@
+package cui.core
+
+import lgui.{Key, MouseButton, Rect, Size, UiEvent}
+
+/*
+ * registerFocusStop：给"自身即控件"的自绘件开放焦点登记（缺口 #2 的第二个入口）。
+ * 这里用一个仿应用层 GhostIconButton 的最小控件验证：构建期登记 → 进 Tab 环 → Enter 激活。
+ */
+private class SelfRegisteringBox <: Widget {
+    private let onClick: () -> Unit
+    private var frame = Rect.zero()
+
+    public init(id: String, onClick: () -> Unit) {
+        this.onClick = onClick
+        registerFocusStop(id)
+        emit(this)
+    }
+
+    public func measure(_: UiContext, _: Size): Size {
+        Size(34.0, 34.0)
+    }
+
+    public func layout(_: UiContext, rect: Rect): Unit {
+        frame = rect
+    }
+
+    public func draw(_: UiContext): Unit {}
+
+    public func focusableId(): ?String {
+        Some("self.box")
+    }
+
+    public func handle(ctx: UiContext, event: UiEvent): Bool {
+        match (event) {
+            case UiEvent.KeyDown(Key.Enter, _) =>
+                if (ctx.hasFocus("self.box")) {
+                    onClick()
+                    return true
+                }
+            case _ => ()
+        }
+        false
+    }
+}
+
+@Test
+func registerFocusStopPutsSelfDrawnWidgetInTabRing(): Unit {
+    let ctx = testContext()
+    let store = StateStore()
+    let fired = State<Bool>(false)
+    let _ = buildRoot({
+        => VStack {
+            Button("A", {=>}).key("rs.button")
+            SelfRegisteringBox("self.box", {=> fired.value = true})
+        }
+    }, store)
+
+    let ring = store.focusRing()
+    @Expect(ring.size, Int64(2))
+    @Expect(ring[1], "self.box")
+
+    ctx.adoptFocusRing(ring)
+    ctx.focusNext()
+    @Expect(ctx.focusId, "rs.button")
+    ctx.focusNext()
+    @Expect(ctx.focusId, "self.box")
+}
+
+@Test
+func registerFocusStopIsNoOpOutsideBuildRoot(): Unit {
+    // buildRoot 之外登记是 no-op：不抛异常、不进任何环。
+    registerFocusStop("loose.box")
+    let store = StateStore()
+    let _ = buildRoot({=> Button("A", {=>}).key("rs.only")}, store)
+    @Expect(store.focusRing().size, Int64(1))
+}
diff --git a/src/core/focus_target.cj b/src/core/focus_target.cj
index 3fd191b..2d17b98 100644
--- a/src/core/focus_target.cj
+++ b/src/core/focus_target.cj
@@ -15,6 +15,24 @@ import std.collection.ArrayList
  * 认领 Interactive 光标。布局/绘制全部透传子树——它是一个行为壳，不加任何视觉。
  * 应用侧用法：FocusTarget(onClick: {...}, key: "card") { 自绘内容 }。
  */
+/*
+ * 让"自身就是控件"的自绘件在构建期登记焦点停靠点（缺口 #2 的第二个入口）。
+ *
+ * FocusTarget 适合包裹一段 builder 子树；但应用层还有一类控件（GhostIconButton、封面卡）
+ * 本身就是 Widget，无法用包裹器的写法。框架内部的 registerFocusable 是 protected，
+ * 应用拿不到，于是这些控件永远进不了 Tab 环——这里把它开放成公开 API：
+ * 在 init 里调用一次，之后控件自己实现 focusableId()/handle()/draw() 即可被 Tab 到达。
+ * 在 buildRoot 之外调用是 no-op（与框架内部一致）。
+ */
+public func registerFocusStop(id: String): Unit {
+    registerFocusable(id)
+}
+
+/** 树形状变化时改写已登记的焦点停靠点（id 变化时焦点不丢）。 */
+public func reregisterFocusStop(previousId: String, id: String): Unit {
+    reregisterFocusable(previousId, id)
+}
+
 public class FocusTarget <: Widget {
     private let id: String
     private let child: Widget
