+/* TextArea 编辑菜单项：与字段同一语义；粘贴保留换行（多行控件）。 */
+@Test
+func areaEditMenuItemsMatchFieldSemantics(): Unit {
+    let ctx = menuFieldContext()
+    let text = State<String>("line1\nline2")
+    let area = TextArea(text, key: "am.a")
+    area.layout(ctx, Rect(0.0, 0.0, 300.0, 100.0))
+    let items = area.editMenuItems()
+    @Expect(items.size, Int64(4))
+    // 无选区：剪切/复制灰。
+    @Expect(!items[0].isEnabled())
+    @Expect(!items[1].isEnabled())
+    @Expect(items[2].isEnabled())
+    // 全选 → 剪切可用 → 执行后清空。
+    items[3].invoke()
+    let after = area.editMenuItems()
+    @Expect(after[0].isEnabled())
+    after[0].invoke()
+    @Expect(text.value, "")
+}
+
+@Test
+func areaEditMenuReadOnlyGraysCutPaste(): Unit {
+    let ctx = menuFieldContext()
+    let text = State<String>("ro 多行")
+    let area = TextArea(text, key: "am.ro", editable: false)
+    area.layout(ctx, Rect(0.0, 0.0, 300.0, 100.0))
+    let items = area.editMenuItems()
+    @Expect(!items[0].isEnabled())
+    @Expect(!items[2].isEnabled())
+}
+
