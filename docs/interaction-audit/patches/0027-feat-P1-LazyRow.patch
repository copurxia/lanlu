+package cui.core
+
+import lgui.{FrameInfo, Key, Rect, Size, UiEvent}
+
+/* LazyRow 键盘横向滚动 + 焦点滚入视野（缺口 #7/#8 的横排版本）。 */
+private class RowFocusProbe <: Widget {
+    private let report: Rect
+
+    public init(report: Rect) {
+        this.report = report
+        emit(this)
+    }
+
+    public func measure(_: UiContext, _: Size): Size {
+        Size(80.0, 40.0)
+    }
+
+    public func layout(ctx: UiContext, _: Rect): Unit {
+        ctx.reportFocusRect("row.target", report)
+    }
+
+    public func draw(_: UiContext): Unit {}
+
+    public func handle(_: UiContext, _: UiEvent): Bool {
+        false
+    }
+}
+
+@Test
+func lazyRowArrowKeysScrollHorizontally(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let row = LazyRow(10, 80.0, scroll: offset, id: "row.kbd") {
+        _ => emit(RowFocusProbe(Rect(0.0, 0.0, 80.0, 40.0)))
+    }
+    row.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+
+    @Expect(row.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    ctx.frame = FrameInfo(UInt64(200), UInt64(16))
+    row.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+    @Expect(offset.value, Float32(48.0))
+
+    // Home 回起点。
+    @Expect(row.handle(ctx, UiEvent.KeyDown(Key.Home, false)))
+    ctx.frame = FrameInfo(UInt64(500), UInt64(300))
+    row.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+    @Expect(offset.value, Float32(0.0))
+}
+
+@Test
+func lazyRowRevealsFocusedItem(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    // 焦点项在视口右侧外（x=300，视口 200 宽）。
+    let row = LazyRow(10, 80.0, scroll: offset, id: "row.reveal") {
+        _ => emit(RowFocusProbe(Rect(300.0, 0.0, 80.0, 40.0)))
+    }
+    ctx.focus("row.target", viaKeyboard: true)
+    row.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+    @Expect(offset.value > Float32(0.0)) // 已滚动露出焦点项
+}
+
+@Test
+func lazyRowLeavesVisibleFocusAlone(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let row = LazyRow(10, 80.0, scroll: offset, id: "row.stay") {
+        _ => emit(RowFocusProbe(Rect(10.0, 0.0, 80.0, 40.0)))
+    }
+    ctx.focus("row.target", viaKeyboard: true)
+    row.layout(ctx, Rect(0.0, 0.0, 200.0, 60.0))
+    @Expect(offset.value, Float32(0.0))
+}
