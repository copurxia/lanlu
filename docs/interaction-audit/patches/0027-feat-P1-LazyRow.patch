+    // 键盘键先给已构建的项（右→左，与点击路由同序），任一项消费即视为已处理。
+    private func childConsumes(ctx: UiContext, event: UiEvent): Bool {
+        var i = visibleItems.size - 1
+        while (i >= 0) {
+            let (_, widget) = visibleItems[i]
+            if (widget.handle(ctx, event)) {
+                return true
+            }
+            i -= 1
+        }
+        false
+    }
+
+    private func revealFocusedInRow(ctx: UiContext, rect: Rect, content: Float32): Unit {
+        match (ctx.focusedRect()) {
+            case Some(focus) =>
+                let left = focus.x - rect.x
+                let right = left + focus.w
+                if (left >= 0.0 && right <= rect.w) {
+                    return
+                }
+                let target = scrollStateValue.value + left
+                let clamped = clampScrollOffset(target, content, rect.w)
+                if (clamped != scrollStateValue.value) {
+                    scrollStateValue.value = clamped
+                    scrollMotion.reset(clamped)
+                    ctx.requestFrame()
+                }
+            case None => ()
+        }
     }
 
