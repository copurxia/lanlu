+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, Size, UiEvent}
+import cui.core.{State, StateStore, Theme, UiContext, Widget, emit}
+
+/* 空记录画布（同 controls 包共享件）：抽屉绘制走表面/阴影，headless 无后端会抛异常。 */
+private func drawerContext(w: Float32, h: Float32): UiContext {
+    let renderer = Renderer.headless()
+    renderer.useBackend(NoopTestCanvas())
+    let ctx = UiContext(renderer, Theme.light())
+    ctx.viewportWidth = w
+    ctx.viewportHeight = h
+    ctx
+}
+
+private class DrawerProbe <: Widget {
+    public func measure(_: UiContext, _: Size): Size {
+        Size(100.0, 40.0)
+    }
+    public func layout(_: UiContext, _: Rect): Unit {}
+    public func draw(_: UiContext): Unit {}
+    public func handle(_: UiContext, _: UiEvent): Bool {
+        false
+    }
+}
+
+/*
+ * Drawer 此前**没有任何测试**（270 行交互代码）：这里固化三条文档承诺——
+ * Esc 关闭并回调、点遮罩关闭而点面板不关闭、关闭后恢复打开前的焦点。
+ */
+@Test
+func drawerEscapeDismissesAndCallsBack(): Unit {
+    let ctx = drawerContext(800.0, 600.0)
+    let presented = State<Bool>(true)
+    let dismissed = State<Int64>(0)
+    let drawer = Drawer(presented, width: 240.0, onDismiss: {=> dismissed.value += 1}) {
+        emit(DrawerProbe())
+    }
+    drawer.layout(ctx, Rect.zero())
+    drawer.draw(ctx)
+    @Expect(ctx.hasOverlay())
+
+    @Expect(ctx.dispatchOverlay(UiEvent.KeyDown(Key.Escape, false)))
+    @Expect(dismissed.value, Int64(1))
+    @Expect(!presented.value)
+}
+
+@Test
+func drawerScrimClickDismissesButPanelClickDoesNot(): Unit {
+    let ctx = drawerContext(800.0, 600.0)
+    let presented = State<Bool>(true)
+    let drawer = Drawer(presented, width: 240.0) {
+        emit(DrawerProbe())
+    }
+    drawer.layout(ctx, Rect.zero())
+    drawer.draw(ctx)
+
+    // 面板宽 240 贴左边：点面板内（x=100）不应关闭。
+    let _ = ctx.dispatchOverlay(UiEvent.MouseDown(MouseButton.Left, 100.0, 300.0))
+    @Expect(presented.value)
+
+    // 点遮罩（x=500，面板外）→ 关闭。
+    let _ = ctx.dispatchOverlay(UiEvent.MouseDown(MouseButton.Left, 500.0, 300.0))
+    @Expect(!presented.value)
+}
+
+@Test
+func drawerCloseRestoresPriorFocus(): Unit {
+    let ctx = drawerContext(800.0, 600.0)
+    let presented = State<Bool>(true) // 构造时就打开：content 在构建期建立
+    // 打开前的焦点：面板外的停靠点。
+    ctx.focus("outside.stop", viaKeyboard: true)
+    let drawer = Drawer(presented, width: 240.0) {
+        emit(DrawerProbe())
+    }
+    drawer.layout(ctx, Rect.zero())
+    drawer.draw(ctx) // 注册浮层
+    ctx.drawActiveOverlay() // 渲染浮层 → claimInitialFocus 记住打开前的焦点
+    @Expect(ctx.hasOverlay())
+
+    // 焦点移进面板（模拟用户 Tab 进入），然后关闭：应恢复到 outside.stop。
+    ctx.focus("inside.stop", viaKeyboard: true)
+    presented.value = false
+    drawer.layout(ctx, Rect.zero()) // claimInitialFocus 在 layout 里（弹簧与内容布局同帧一致）
+    drawer.draw(ctx) // 关闭滑出期仍注册
+    @Expect(ctx.hasOverlay())
+    ctx.drawActiveOverlay()
+    @Expect(ctx.hasFocus("outside.stop"))
+}
