             case UiEvent.KeyDown(Key.Down, _) => return openFocused(ctx)
             case UiEvent.KeyDown(Key.Enter, _) => return openFocused(ctx)
             case UiEvent.KeyDown(Key.Space, _) => return openFocused(ctx)
+            // Menu 键（或 F10，RawScancode 68）：像 Windows 菜单栏一样唤起菜单——
+            // 聚焦菜单栏并打开上次/第一个标题（审计缺口 #13 的菜单栏部分）。
+            case UiEvent.KeyDown(Key.Menu, _) => return openFromShortcut(ctx)
+            case UiEvent.KeyDown(Key.RawScancode(F10_SCANCODE), _) => return openFromShortcut(ctx)
             case _ => ()
         }
         false
@@ -139,6 +145,16 @@ public class MenuBar <: Widget {
         true
     }
 
+    // 快捷键唤起：无焦点也接受（菜单栏是窗口级加速器），聚焦并打开标题。
+    private func openFromShortcut(ctx: UiContext): Bool {
+        if (menus.isEmpty()) {
+            return false
+        }
+        ctx.focus(id, viaKeyboard: true)
+        openMenu(wrapIndex(focusedTitle.value, menus.size))
+        true
+    }
+
     private func openFocused(ctx: UiContext): Bool {
         if (!ctx.hasFocus(id) || menus.isEmpty()) {
             return false
diff --git a/src/controls/menu_bar_shortcut_test.cj b/src/controls/menu_bar_shortcut_test.cj
new file mode 100644
index 0000000..0e699ba
--- /dev/null
+++ b/src/controls/menu_bar_shortcut_test.cj
@@ -0,0 +1,25 @@
+package cui.controls
+
+import lgui.{Key, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+/* MenuBar 快捷键唤起（缺口 #13 菜单栏部分）：Menu 键 / F10 在无焦点时也能打开菜单。 */
+@Test
+func menuBarOpensWithMenuKeyShortcut(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    ctx.viewportWidth = 400.0
+    ctx.viewportHeight = 300.0
+    let picked = State<Int64>(0)
+    let bar = MenuBar([
+        Menu("文件", [MenuItem("新建", {=> picked.value = 1 })]),
+        Menu("编辑", [MenuItem("撤销", {=> picked.value = 2 })])
+    ], key: "mb.shortcut")
+    bar.layout(ctx, Rect(0.0, 0.0, 400.0, 34.0))
+
+    ctx.clearFocus()
+    @Expect(bar.handle(ctx, UiEvent.KeyDown(Key.Menu, false))) // 无需先 Tab 到菜单栏
+    @Expect(ctx.hasFocus("mb.shortcut"))
+
+    ctx.clearFocus()
+    @Expect(bar.handle(ctx, UiEvent.KeyDown(Key.RawScancode(68), false))) // F10 同效
+}
