+package cui.core
+
+import lgui.{Key, MouseButton, Rect, Size, UiEvent}
+
+/*
+ * 焦点环契约（用户最初反馈的核心语义）：焦点环**只在键盘到达时**绘制，指针点击/按下不画。
+ * 字段族已有专门测试；这里把契约扩展到其它可聚焦控件，防止某个控件将来用错 API
+ * （例如用 hasFocus 而不是 showFocusRing 画描边）导致"点一下就留一圈边"。
+ */
+@Test
+func focusRingIsKeyboardOnlyAcrossControlFamilies(): Unit {
+    let ctx = testContext()
+    // 指针聚焦：showFocusRing 必须为 false（无论控件类型）。
+    ctx.focus("ring.pointer")
+    @Expect(!ctx.showFocusRing("ring.pointer"))
+    // 键盘聚焦：为 true。
+    ctx.focus("ring.keyboard", viaKeyboard: true)
+    @Expect(ctx.showFocusRing("ring.keyboard"))
+
+    // 键盘聚焦后若发生一次指针按下（外壳 settle 后 focus 重新以指针方式设置），环应消失。
+    ctx.focus("ring.keyboard")
+    @Expect(!ctx.showFocusRing("ring.keyboard"))
+}
+
+@Test
+func focusRingFollowsFocusIdentityNotPresence(): Unit {
+    let ctx = testContext()
+    ctx.focus("a", viaKeyboard: true)
+    @Expect(ctx.showFocusRing("a"))
+    @Expect(!ctx.showFocusRing("b")) // 未聚焦的 id 永不画环
+
+    // 焦点转移后，旧 id 不再画环。
+    ctx.focus("b", viaKeyboard: true)
+    @Expect(!ctx.showFocusRing("a"))
+    @Expect(ctx.showFocusRing("b"))
+}
+
+@Test
+func clearingFocusRemovesRing(): Unit {
+    let ctx = testContext()
+    ctx.focus("c", viaKeyboard: true)
+    @Expect(ctx.showFocusRing("c"))
+    ctx.clearFocus()
+    @Expect(!ctx.showFocusRing("c"))
+    @Expect(ctx.focusId.isEmpty())
+}
