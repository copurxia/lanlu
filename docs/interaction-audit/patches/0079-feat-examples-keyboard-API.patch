+/*
+ * CUI 示例：键盘交互一览。
+ */
+package cui_keyboard
+
+import cui.{DesktopApp, WindowSpec}
+
+main(): Int64 {
+    let app = DesktopApp(WindowSpec("CUI 键盘交互一览", 760, 520, scale: 1.5))
+    app.setMinimumSize(600, 420)
+    app.run {
+        keyboardView()
+    }
+    return 0
+}
