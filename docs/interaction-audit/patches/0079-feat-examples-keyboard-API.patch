+/*
+ * 键盘交互一览：FocusTarget / ListView(onActivate) / editMenuItems / Shift 区间选择。
+ */
+package cui_keyboard
+
+import cui.{FocusTarget, HStack, Label, LengthUnits, ListView, Observable, Panel, State, TextField, VStack}
+import cui.controls.ContextMenu
+
+func keyboardView(): Unit {
+    let picked = State<String>("（未选择）")
+    let query = State<String>("")
+    let selected = State<Int64>(0)
+    let fruits = ["苹果 Apple", "香蕉 Banana", "樱桃 Cherry", "榴莲 Durian", "无花果 Fig", "葡萄 Grape"]
+
+    VStack {
+        Label("键盘交互一览").fontSize(19.0)
+        Label("Tab 遍历全部停靠点；方向键移动；Shift+方向键区间选择；双击或 Enter 激活").muted().wrap()
+
+        HStack {
+            Panel {
+                VStack {
+                    Label("列表（双击 / Enter 激活）").muted()
+                    ListView(fruits, selected, key: "fruit.list", onActivate: {i => picked.value = fruits[i]})
+                        .flex()
+                }.spacing(6.vp)
+            }.contentPadding(12.vp).flex()
+
+            VStack {
+                Label("自绘卡片（FocusTarget 包裹）").muted()
+                FocusTarget(onClick: {=> picked.value = "卡片被激活"}, key: "card.target") {
+                    VStack {
+                        Label("整块可点").fontSize(14.0)
+                        Label("Tab 到这里按 Enter").muted().fontSize(12.0)
+                    }.spacing(2.vp)
+                }
+                Label("已选择：").muted()
+                Label(picked.value).wrap() // 立即模式：每帧重建时读取当前值
+            }.spacing(8.vp).flex()
+        }.flex()
+
+        HStack {
+            Label("搜索：").muted()
+            ContextMenu(items: TextField(query, key: "q.field").editMenuItems()) {
+                TextField(query, key: "q.field")
+            }.flex()
+        }
+        Label("右键输入框：剪切/复制/粘贴/全选（按状态置灰）").muted().fontSize(12.0)
+    }.spacing(12.vp).padding(16.vp)
+}
