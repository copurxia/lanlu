@@ -0,0 +1,74 @@
+package cui.core
+
+import lgui.{FrameInfo, Rect, Size, UiEvent}
+
+/*
+ * 焦点滚入视野（缺口 #8）：控件在 layout 中上报焦点矩形，ScrollView 在 layout 末尾把
+ * 视口外的焦点滚入视野——此前 Tab 到视口外的控件时焦点“消失”。
+ */
+private class FocusReportingProbe <: Widget {
+    private let report: Rect
+
+    public init(report: Rect) {
+        this.report = report
+        emit(this)
+    }
+
+    public func measure(_: UiContext, _: Size): Size {
+        Size(120.0, 400.0)
+    }
+
+    public func layout(ctx: UiContext, _: Rect): Unit {
+        ctx.reportFocusRect("reveal.target", report)
+    }
+
+    public func draw(_: UiContext): Unit {}
+
+    public func handle(_: UiContext, _: UiEvent): Bool {
+        false
+    }
+}
+
+@Test
+func scrollViewRevealsFocusedRectBelowViewport(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    // 焦点控件在内容 y=300（视口只有 100 高）——应在 layout 后被滚入视野。
+    let probe = FocusReportingProbe(Rect(0.0, 300.0, 120.0, 30.0))
+    let view = ScrollView(key: "reveal.view") {
+        emit(probe)
+    }.scrollState(offset)
+    ctx.focus("reveal.target", viaKeyboard: true)
+
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 100.0))
+    // 焦点底边 330，视口 100 → 滚动到 230（刚好贴底）。
+    @Expect(offset.value, Float32(230.0))
+}
+
+@Test
+func scrollViewLeavesVisibleFocusAlone(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let probe = FocusReportingProbe(Rect(0.0, 20.0, 120.0, 30.0))
+    let view = ScrollView(key: "reveal.visible") {
+        emit(probe)
+    }.scrollState(offset)
+    ctx.focus("reveal.target", viaKeyboard: true)
+
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 100.0))
+    @Expect(offset.value, Float32(0.0)) // 已在视口内：不动
+}
+
+@Test
+func focusRectRoundTripsThroughContext(): Unit {
+    let ctx = testContext()
+    @Expect(ctx.focusedRect().isNone()) // 无焦点
+    ctx.reportFocusRect("a", Rect(1.0, 2.0, 3.0, 4.0))
+    ctx.focus("a")
+    let rect = ctx.focusedRect().getOrThrow()
+    @Expect(rect.x, Float32(1.0))
+    @Expect(rect.w, Float32(3.0))
+
+    ctx.clearFocusRects()
+    @Expect(ctx.focusedRect().isNone()) // 外壳每帧清空
+}
