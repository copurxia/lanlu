 package cui.core
 
 import std.collection.ArrayList
+import std.collection.HashMap
 import lgui.{Color, FrameInfo, Insets, Rect, Renderer, SurfaceStyle, UiEvent}
 
 // A second press within this window and distance of the previous one continues a multi-click.
@@ -249,6 +250,11 @@ public class UiContext {
     public let renderer: Renderer
     public var theme: Theme
     public var focusId: String = ""
+
+    // 焦点控件的布局矩形（每帧由控件在 layout 中上报；容器据此把焦点滚入视野，审计缺口 #8）。
+    // 用 id → Rect 的槽位而非单值：Tab 移动发生在事件阶段，下一帧 layout 时新旧两个控件都可能
+    // 上报，容器只需查自己要处理的 id。
+    private var focusRects: HashMap<String, Rect> = HashMap<String, Rect>()
     // Whether the focused control should paint a ring: true when focus last moved by keyboard
     // (Tab traversal or autofocus), false when a pointer press claimed it — the :focus-visible
     // convention. Behaviour (activation, caret, arrow nav) uses `focusId`; only the ring gates on this.
@@ -457,6 +463,28 @@ public class UiContext {
         focusRingVisible = viaKeyboard
     }
 
+    /*
+     * 上报一个可聚焦控件的布局矩形（控件在 layout 里调用）。容器（ScrollView/LazyList 等）
+     * 在 layout 末尾查 focusedRect() 即可把焦点滚入视野——无需保留 Widget 引用。
+     * 每帧由外壳在 layout 之前经 clearFocusRects() 清空，避免陈旧矩形。
+     */
+    public func reportFocusRect(id: String, rect: Rect): Unit {
+        focusRects[id] = rect
+    }
+
+    /** 当前焦点控件的矩形（若本帧已上报）。 */
+    public func focusedRect(): ?Rect {
+        if (focusId.size == 0) {
+            return None
+        }
+        focusRects.get(focusId)
+    }
+
+    /** 外壳在每帧 layout 前清空矩形表。 */
+    public func clearFocusRects(): Unit {
+        focusRects.clear()
+    }
+
     /** Removes keyboard focus from every control. */
     public func clearFocus(): Unit {
         focusId = ""
