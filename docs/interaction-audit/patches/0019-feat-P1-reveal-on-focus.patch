index 5b06966..612989e 100644
--- a/src/core/advanced_layouts.cj
+++ b/src/core/advanced_layouts.cj
@@ -388,6 +388,33 @@ public class ScrollView <: Widget {
         }
         let visibleOffset = scrollMotion.animate(ctx, scrollOffset, contentHeight, rect.h)
         child.layout(ctx, Rect(rect.x, rect.y - visibleOffset, contentWidth, contentHeight))
+        revealFocused(ctx, rect, contentHeight)
+    }
+
+    /*
+     * 焦点滚入视野（审计缺口 #8）：Tab 把焦点移到视口外时，容器把滚动偏移拉到刚好能看见它
+     * ——此前焦点会“跑到屏幕外”，用户以为焦点丢了。焦点控件矩形由控件在 layout 中经
+     * ctx.reportFocusRect 上报，这里只做最小滚动：已在视口内不动，否则贴边。
+     */
+    private func revealFocused(ctx: UiContext, rect: Rect, contentHeight: Float32): Unit {
+        match (ctx.focusedRect()) {
+            case Some(focus) =>
+                let top = focus.y - rect.y
+                let bottom = top + focus.h
+                var target = scrollOffset.value
+                if (top < 0.0) {
+                    target = scrollOffset.value + top
+                } else if (bottom > rect.h) {
+                    target = scrollOffset.value + (bottom - rect.h)
+                }
+                let clamped = clampScrollOffset(target, contentHeight, rect.h)
+                if (clamped != scrollOffset.value) {
+                    scrollOffset.value = clamped
+                    scrollMotion.reset(clamped)
+                    ctx.requestFrame()
+                }
+            case None => ()
+        }
     }
 
     public func draw(ctx: UiContext): Unit {
