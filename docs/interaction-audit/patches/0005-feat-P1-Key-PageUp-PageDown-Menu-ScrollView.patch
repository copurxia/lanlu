--- /dev/null
+++ b/src/core/scroll_keyboard_test.cj
@@ -0,0 +1,118 @@
+package cui.core
+
+import lgui.{FrameInfo, Key, Rect, Renderer, Size, UiEvent}
+
+/*
+ * 键盘滚动（审计缺口 #7）：ScrollView 此前只认滚轮/滚动条，纯键盘用户无法翻页。
+ * PageUp/PageDown = 0.9 视口（与滚动条轨道点击同一步长），方向键 48px，Home/End 到顶/底。
+ * 与滚轮同一条 scrollBy 通路，缓动一致；子树不消费滚动键时才滚动，滚到边返回 false。
+ */
+@Test
+func scrollViewPageKeysScrollByViewport(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let child = SizedLayoutProbe(Size(120.0, 400.0))
+    let view = ScrollView(key: "kbd.pages") {
+        emit(child)
+    }.scrollState(offset)
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.PageDown, false)))
+    ctx.frame = FrameInfo(UInt64(200), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(72.0)) // 0.9 * 80
+
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.PageUp, false)))
+    ctx.frame = FrameInfo(UInt64(400), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(0.0))
+}
+
+@Test
+func scrollViewArrowKeysStepAndClamp(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let child = SizedLayoutProbe(Size(120.0, 200.0))
+    let view = ScrollView(key: "kbd.arrows") {
+        emit(child)
+    }.scrollState(offset)
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Down, false)))
+    ctx.frame = FrameInfo(UInt64(200), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(48.0))
+
+    // 让缓动走完（scrollBy 在动画未停住时报“已处理”，与滚轮一致）。
+    ctx.frame = FrameInfo(UInt64(400), UInt64(200))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    ctx.frame = FrameInfo(UInt64(700), UInt64(300))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+
+    // 向上在顶端：offset 不再变化（scrollBy 在边缘的返回值取决于缓动是否停住，
+    // 文档语义是“无内容可滚”，但动画尾巴期间仍报已处理——这里断言用户可见的结果）。
+    let _ = view.handle(ctx, UiEvent.KeyDown(Key.Up, false))
+    ctx.frame = FrameInfo(UInt64(1000), UInt64(300))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(0.0)) // 顶端不越界
+}
+
+@Test
+func scrollViewHomeEndJumpToDocumentEnds(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let child = SizedLayoutProbe(Size(120.0, 300.0))
+    let view = ScrollView(key: "kbd.ends") {
+        emit(child)
+    }.scrollState(offset)
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.End, false)))
+    ctx.frame = FrameInfo(UInt64(200), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(220.0)) // 300 - 80
+
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Home, false)))
+    ctx.frame = FrameInfo(UInt64(400), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(0.0))
+}
+
+@Test
+func scrollViewKeysYieldToFocusableChild(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let sink = KeySinkControl()
+    let view = ScrollView(key: "kbd.child") {
+        emit(sink)
+    }.scrollState(offset)
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+
+    // 子控件消费了 PageDown（例如 TextArea 翻页）——外层不滚动。
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.PageDown, false)))
+    @Expect(sink.consumed)
+    ctx.frame = FrameInfo(UInt64(200), UInt64(16))
+    view.layout(ctx, Rect(0.0, 0.0, 120.0, 80.0))
+    @Expect(offset.value, Float32(0.0))
+}
+
+/* 消费一切按键的哑控件：模拟可聚焦子树（TextArea/内嵌列表）先行消费滚动键。 */
+class KeySinkControl <: Widget {
+    public var consumed = false
+    public init() {
+        emit(this)
+    }
+    public func measure(_: UiContext, _: Size): Size {
+        Size(120.0, 400.0)
+    }
+    public func layout(_: UiContext, _: Rect): Unit {}
+    public func draw(_: UiContext): Unit {}
+    public func handle(_: UiContext, event: UiEvent): Bool {
+        match (event) {
+            case UiEvent.KeyDown(_, _) =>
+                consumed = true
+                true
+            case _ => false
+        }
+    }
+}
