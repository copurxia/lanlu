         let base = match (key) {
@@ -301,6 +304,14 @@ public class TreeView <: Widget {
         if (current >= 0 && rows[current].hasChildren) {
             toggleExpanded(rows[current].id)
         }
+        // 叶子节点（无子级）的 Enter/空格是"激活"：通知应用（如导航树打开该项）。
+        // 有子级时 Enter 语义是展开/折叠，不触发激活——与文件浏览器的直觉一致。
+        if (current >= 0 && !rows[current].hasChildren) {
+            match (onActivate) {
+                case Some(activate) => activate(rows[current].id)
+                case None => ()
+            }
+        }
         true
     }
 
