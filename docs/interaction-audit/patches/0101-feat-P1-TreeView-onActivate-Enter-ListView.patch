+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+/*
+ * TreeView 叶子激活（onActivate）：Enter/空格在**叶子**上触发回调（导航树打开该项）；
+ * 有子级的节点 Enter 语义是展开/折叠，不触发激活——与文件浏览器的直觉一致。
+ */
+private func treeCtx(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+private func sampleTree(): Array<TreeNode> {
+    [
+        TreeNode("books", "书库", children: [
+            TreeNode("b1", "第一卷"),
+            TreeNode("b2", "第二卷")
+        ]),
+        TreeNode("settings", "设置")
+    ]
+}
+
+@Test
+func treeEnterOnLeafActivates(): Unit {
+    let ctx = treeCtx()
+    let sel = State<String>("")
+    let activated = State<String>("")
+    let tree = TreeView(sampleTree(), sel, key: "t.tree", initiallyExpanded: ["books"],
+        onActivate: {id => activated.value = id})
+    tree.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+    // 选中叶子 b1（第 2 行）后按 Enter：应激活 b1。
+    let _ = tree.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, 10.0)) // 第一行
+    @Expect(sel.value, "books")
+    let _ = tree.handle(ctx, UiEvent.KeyDown(Key.Down, false)) // ↓ 到第一卷（已展开）
+    @Expect(sel.value, "b1")
+    @Expect(tree.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(activated.value, "b1")
+}
+
+@Test
+func treeEnterOnParentExpandsWithoutActivating(): Unit {
+    let ctx = treeCtx()
+    let sel = State<String>("")
+    let activated = State<String>("(none)")
+    let tree = TreeView(sampleTree(), sel, key: "p.tree",
+        onActivate: {id => activated.value = id})
+    tree.layout(ctx, Rect(0.0, 0.0, 200.0, 200.0))
+    let _ = tree.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 100.0, 10.0)) // 第一行
+    @Expect(sel.value, "books")
+    @Expect(tree.handle(ctx, UiEvent.KeyDown(Key.Enter, false))) // 收起子级（展开态→折叠）
+    @Expect(activated.value, "(none)") // 不触发激活
+    let _ = tree.handle(ctx, UiEvent.KeyDown(Key.Down, false)) // ↓（已折叠）到设置
+    @Expect(sel.value, "settings")
+    @Expect(tree.handle(ctx, UiEvent.KeyDown(Key.Enter, false))) // 叶子：激活
+    @Expect(activated.value, "settings")
+}
