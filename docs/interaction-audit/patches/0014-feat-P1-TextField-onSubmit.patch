diff --git a/src/text/text_field_submit_test.cj b/src/text/text_field_submit_test.cj
new file mode 100644
index 0000000..3a1b36d
--- /dev/null
+++ b/src/text/text_field_submit_test.cj
@@ -0,0 +1,29 @@
+package cui.text
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+@Test
+func textFieldEnterCallsSubmitWhenFocused(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let value = State<String>("value")
+    let calls = State<Int64>(0)
+    let field = TextField(value, key: "submit.field", onSubmit: {=> calls.value += 1})
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 32.0))
+
+    @Expect(!field.handle(ctx, UiEvent.KeyDown(Key.Enter, false))) // 未聚焦透传
+    @Expect(calls.value, Int64(0))
+
+    let _ = field.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 20.0, 16.0))
+    @Expect(field.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(calls.value, Int64(1))
+}
+
+@Test
+func textFieldEnterWithoutSubmitPreservesNoop(): Unit {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    let field = TextField(State<String>("v"), key: "submit.none")
+    field.layout(ctx, Rect(0.0, 0.0, 200.0, 32.0))
+    let _ = field.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 20.0, 16.0))
+    @Expect(!field.handle(ctx, UiEvent.KeyDown(Key.Enter, false))) // 兼容旧行为：无回调不消费
+}
