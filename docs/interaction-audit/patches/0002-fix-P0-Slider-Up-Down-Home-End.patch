+package cui.controls
+
+import lgui.{Key, MouseButton, Rect, Renderer, UiEvent}
+import cui.core.{Bindable, State, Theme, UiContext}
+
+private func sliderTestContext(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+// 聚焦后 Up/Down 与 Left/Right 同向；Home/End 跳两端；未聚焦不消费。
+@Test
+func sliderKeyboardStepsUpAndDown(): Unit {
+    let ctx = sliderTestContext()
+    let value = State<Float32>(50.0)
+    let slider = Slider(value, key: "kbd.slider", lower: 0.0, upper: 100.0, step: 10.0)
+    slider.layout(ctx, Rect(0.0, 0.0, 180.0, 32.0))
+
+    @Expect(!slider.handle(ctx, UiEvent.KeyDown(Key.Right, false))) // 未聚焦
+    @Expect(value.value, Float32(50.0))
+
+    // 点击轨道中段聚焦（点击本身也会把值设到点击位置：x=94 → 约 50，离散到 50）。
+    @Expect(slider.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 94.0, 16.0)))
+    @Expect(ctx.hasFocus("kbd.slider"))
+    @Expect(value.value, Float32(50.0))
+
+    @Expect(slider.handle(ctx, UiEvent.KeyDown(Key.Up, false)))
+    @Expect(value.value, Float32(60.0))
+    @Expect(slider.handle(ctx, UiEvent.KeyDown(Key.Down, false)))
+    @Expect(value.value, Float32(50.0))
+    @Expect(slider.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(value.value, Float32(60.0))
+    @Expect(slider.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(value.value, Float32(50.0))
+}
+
+@Test
+func sliderKeyboardHomeEndJumpToRangeEnds(): Unit {
+    let ctx = sliderTestContext()
+    let value = State<Float32>(40.0)
+    let slider = Slider(value, key: "kbd.ends", lower: 0.0, upper: 100.0, step: 10.0)
+    slider.layout(ctx, Rect(0.0, 0.0, 180.0, 32.0))
+    let _ = slider.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 80.0, 16.0)) // 聚焦
+    let _ = slider.handle(ctx, UiEvent.KeyDown(Key.End, false))
+    @Expect(value.value, Float32(100.0))
+    let _ = slider.handle(ctx, UiEvent.KeyDown(Key.Home, false))
+    @Expect(value.value, Float32(0.0))
+}
+
+@Test
+func sliderKeyboardClampsOutsideRange(): Unit {
+    let ctx = sliderTestContext()
+    let value = State<Float32>(0.0)
+    let slider = Slider(value, key: "kbd.clamp", lower: 0.0, upper: 100.0, step: 10.0)
+    slider.layout(ctx, Rect(0.0, 0.0, 180.0, 32.0))
+    let _ = slider.handle(ctx, UiEvent.MouseDown(MouseButton.Left, 10.0, 16.0))
+    let _ = slider.handle(ctx, UiEvent.KeyDown(Key.Down, false))
+    @Expect(value.value, Float32(0.0)) // 不低于下界
+    let _ = slider.handle(ctx, UiEvent.KeyDown(Key.End, false))
+    let _ = slider.handle(ctx, UiEvent.KeyDown(Key.Up, false))
+    @Expect(value.value, Float32(100.0)) // 不高于上界
+}
