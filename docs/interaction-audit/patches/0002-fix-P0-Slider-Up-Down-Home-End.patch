+    // 聚焦时的键盘步进/跳变；未聚焦不消费（事件继续下传）。
+    private func stepIfFocused(ctx: UiContext, delta: Float32): Bool {
+        if (!ctx.hasFocus(id)) {
+            return false
+        }
+        value.value = normalize(value.value + delta)
+        true
