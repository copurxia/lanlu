+++ b/src/media/pixel_staged_eviction_test.cj
@@ -0,0 +1,28 @@
+package cui.media
+
+import std.collection.ArrayList
+
+/*
+ * LRU 淘汰回调必须覆盖 staged 条目（不只是已上传纹理）：应用依赖它把"就绪"状态复位，
+ * 否则被淘汰的 staged 像素永远不会再上传（状态说 ready、像素已没了 → 空白）。
+ */
+@Test
+func evictedStagedEntryNotifiesCallbackAndFreesBytes(): Unit {
+    clearPixelImages()
+    let evicted = ArrayList<String>()
+    onPixelImageEvicted = {k => evicted.add(k)}
+    // 把 CPU staged 分项预算压小，强制淘汰 staged 条目。
+    pixelCacheStagedMaxBytes = 64 // 只够一张 4x4（64 字节）
+    stagePixelImage("evict.a", 4, 4, Array<UInt8>(64, repeat: 0))
+    let (s1, _, _, _) = pixelCacheDiagnostics()
+    @Expect(s1, Int64(64))
+    // 再登记一张同尺寸 → 超过分项预算 → 最旧的 staged 被淘汰并回调。
+    stagePixelImage("evict.b", 4, 4, Array<UInt8>(64, repeat: 0))
+    @Expect(evicted.contains("evict.a"))
+    // 队尾（最新登记）始终保留：B 还在。
+    let (s2, _, _, _) = pixelCacheDiagnostics()
+    @Expect(s2, Int64(64))
+    pixelCacheStagedMaxBytes = 96 * 1024 * 1024
+    onPixelImageEvicted = None
+    clearPixelImages()
+}
