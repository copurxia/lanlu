+    // 当前布局里的链接片段（按出现顺序）。
+    private func linkItems(layout: RichLayout): ArrayList<PlacedItem> {
+        let items = ArrayList<PlacedItem>()
+        for (item in layout.items) {
+            if (item.action.isSome()) {
