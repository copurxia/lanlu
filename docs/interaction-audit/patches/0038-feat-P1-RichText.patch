+package cui.controls
+
+import lgui.{Key, Rect, Renderer, UiEvent}
+import cui.core.{State, Theme, UiContext}
+
+private func rtLinkCtx(): UiContext {
+    UiContext(Renderer.headless(), Theme.light())
+}
+
+/* RichText 链接的键盘可达性（此前只能点）：整段文本一个停靠点，Left/Right 切换链接、Enter 触发。 */
+@Test
+func richTextWithLinksIsFocusable(): Unit {
+    let withLink = RichText([RichSpan.link("详情", {=> ()})], key: "rt.kb")
+    let noLink = RichText([RichSpan.text("纯文本")], key: "rt.plain")
+    @Expect(withLink.focusableId().isSome())
+    @Expect(noLink.focusableId().isNone()) // 无链接不进 Tab 环
+}
+
+@Test
+func richTextKeyboardActivatesFirstLink(): Unit {
+    let ctx = rtLinkCtx()
+    let hits = State<Int64>(0)
+    let view = RichText([
+        RichSpan.link("甲", {=> hits.value += 1 }),
+        RichSpan.text(" "),
+        RichSpan.link("乙", {=> hits.value += 10 })
+    ], key: "rt.act")
+    view.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+    let fid = view.focusableId().getOrThrow()
+    ctx.focus(fid, viaKeyboard: true)
+
+    // 默认选中第一个链接：Enter 触发「甲」。
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(hits.value, Int64(1))
+
+    // Right 切到第二个链接：Enter 触发「乙」（+10）。
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Right, false)))
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(hits.value, Int64(11))
+
+    // Left 回到第一个。
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Left, false)))
+    @Expect(view.handle(ctx, UiEvent.KeyDown(Key.Space, false)))
+    @Expect(hits.value, Int64(12))
+}
+
+@Test
+func richTextWithoutFocusIgnoresKeys(): Unit {
+    let ctx = rtLinkCtx()
+    let hits = State<Int64>(0)
+    let view = RichText([RichSpan.link("甲", {=> hits.value += 1 })], key: "rt.nofocus")
+    view.layout(ctx, Rect(0.0, 0.0, 200.0, 40.0))
+    @Expect(!view.handle(ctx, UiEvent.KeyDown(Key.Enter, false)))
+    @Expect(hits.value, Int64(0))
+}
