+    private func cycleLink(ctx: UiContext, delta: Int64): Bool {
+        let ps = resolvedPointSize(ctx)
+        let lineHeight = ctx.renderer.textHeight(pointSize: ps)
+        let layout = layoutFor(ctx, frame.w, ps, lineHeight)
+        let count = Int64(linkItems(layout).size)
+        if (count == 0) {
+            return false
+        }
+        let next = ((activeLink.value + delta) % count + count) % count
+        activeLink.value = next
+        return true
+    }
+
+    private func activateLink(ctx: UiContext): Bool {
+        let ps = resolvedPointSize(ctx)
+        let lineHeight = ctx.renderer.textHeight(pointSize: ps)
+        let layout = layoutFor(ctx, frame.w, ps, lineHeight)
+        let items = linkItems(layout)
+        if (items.isEmpty()) {
+            return false
+        }
+        let index = max(0, min(Int64(items.size - 1), activeLink.value))
+        match (items[index].action) {
+            case Some(action) =>
+                action()
+                return true
+            case None => ()
+        }
+        false
+    }
