diff --git a/src/core/basic_widgets.cj b/src/core/basic_widgets.cj
index 842d571..11f4c03 100644
--- a/src/core/basic_widgets.cj
+++ b/src/core/basic_widgets.cj
@@ -624,8 +624,30 @@ public class Button <: Widget {
                         // The focus ring (drawn in draw() on keyboard focus) shows where
                         // Enter/Space will land — no need to also recolour the border.
                         style
-                    case _ => base
+                    case ButtonRole.Primary =>
+                        // 实心强调色按钮也有按下/悬停反馈（审计缺口 #11 的局部）：
+                        // 按下更深（向背景色压暗 18%）、悬停更亮（向 accentText 提亮 12%）。
+                        solidFeedback(ctx, base, ctx.theme.accent, ctx.theme.bg, ctx.theme.accentText)
+                    case ButtonRole.Danger =>
+                        solidFeedback(ctx, base, ctx.theme.danger, ctx.theme.bg, ctx.theme.accentText)
                 }
         }
     }
+
+    // 实心按钮的按下/悬停色：按下压暗、悬停提亮；两者都保持原边框色不跳。
+    private func solidFeedback(
+        ctx: UiContext,
+        base: SurfaceStyle,
+        fillColor: Color,
+        pressTarget: Color,
+        hoverTarget: Color
+    ): SurfaceStyle {
+        if (ctx.isPressed(controlId)) {
+            base.withFill(fillColor.lerp(pressTarget, 0.18))
+        } else if (ctx.isHovered(controlId)) {
+            base.withFill(fillColor.lerp(hoverTarget, 0.12))
+        } else {
+            base
+        }
+    }
 }
diff --git a/src/core/button_state_test.cj b/src/core/button_state_test.cj
