TreeView 新增的 onActivate 正好用文件浏览器演示：左树选中文件后按 Enter/空格 = "打开"，
底部状态行显示已打开的路径；父节点的 Enter 仍是展开/折叠（两套语义并存，互不干扰）。

这也让该示例从"只能选中"变成"能打开"，更接近真实资源管理器的行为。
---
 examples/file_explorer/src/model.cj |  2 ++
 examples/file_explorer/src/views.cj | 15 ++++++++++++---
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/examples/file_explorer/src/model.cj b/examples/file_explorer/src/model.cj
index 713dafe..c273f75 100644
--- a/examples/file_explorer/src/model.cj
+++ b/examples/file_explorer/src/model.cj
@@ -13,6 +13,8 @@ class ExplorerModel {
     let roots: Array<TreeNode>
     let index: HashMap<String, FileInfo>
     let selected = State<String>("CangjieGUI/src/core/split_view.cj")
+    // 最近一次"打开"（叶子激活）的文件；空串 = 尚未打开过。
+    let opened = State<String>("")
     // 初始展开：根、src、core 依次打开，恰好露出初始选中的文件。
     let initiallyExpanded = ["CangjieGUI", "CangjieGUI/src", "CangjieGUI/src/core"]
 
diff --git a/examples/file_explorer/src/views.cj b/examples/file_explorer/src/views.cj
index 15b2511..3de2d93 100644
--- a/examples/file_explorer/src/views.cj
+++ b/examples/file_explorer/src/views.cj
@@ -30,9 +30,18 @@ func appHeader(): Unit {
 }
 
 func treePane(model: ExplorerModel): Unit {
-    Panel {
-        TreeView(model.roots, model.selected, initiallyExpanded: model.initiallyExpanded)
-    }.contentPadding(8.vp)
+    VStack {
+        Panel {
+            // 叶子节点的 Enter/空格是"打开"：onActivate 给应用一个明确的入口，
+            // 与展开/折叠（父节点语义）区分开。
+            TreeView(model.roots, model.selected, initiallyExpanded: model.initiallyExpanded,
+                onActivate: {id => model.opened.value = id})
+        }.contentPadding(8.vp).flex()
+        match (model.opened.value.size) {
+            case 0 => Label("在树上选中一个文件后按 Enter/空格打开").muted().fontSize(FontSizes.CAPTION)
+            case _ => Label("已打开：" + model.opened.value).fontSize(FontSizes.CAPTION)
+        }
+    }.spacing(6.vp).flex()
 }
 
 func detailPane(model: ExplorerModel): Unit {
