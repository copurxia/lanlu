+package cui.core
+
+import std.math.abs
+import lgui.Color
+
+/*
+ * F1 的可自动化部分：焦点指示色（accent）在两套主题里都必须与字段底色拉开足够的
+ * 亮度差——否则焦点环/激活边在某个主题下几乎不可见（人工验收只兜视觉风格，这里兜下限）。
+ * 用相对亮度（WCAG 简化式）而非完整对比度公式：足够表达"看得见"的下限且不依赖文本度量。
+ */
+private func luminance(c: Color): Float64 {
+    (0.2126 * Float64(c.r) + 0.7152 * Float64(c.g) + 0.0722 * Float64(c.b)) / 255.0
+}
+
+private func luminanceGap(a: Color, b: Color): Float64 {
+    abs(luminance(a) - luminance(b))
+}
+
+@Test
+func focusAccentStandsOutAgainstFieldInBothThemes(): Unit {
+    // 焦点环/激活边画在 field 底上：亮度差至少 0.18（约 46/255），否则接近不可辨。
+    let themes = [("light", Theme.light()), ("dark", Theme.dark())]
+    for ((name, theme) in themes) {
+        let gap = luminanceGap(theme.accent, theme.field)
+        @Expect(gap >= 0.18)
+    }
+}
+
+@Test
+func focusAccentStandsOutAgainstPanelInBothThemes(): Unit {
+    let themes = [("light", Theme.light()), ("dark", Theme.dark())]
+    for ((name, theme) in themes) {
+        let gap = luminanceGap(theme.accent, theme.panel)
+        @Expect(gap >= 0.18)
+    }
+}
+
+@Test
+func hoverFieldActiveDiffersFromIdleFieldInBothThemes(): Unit {
+    // 悬停三态的可见性下限：fieldActive 与 field 也要拉开差距（悬停反馈能被察觉）。
+    let themes = [("light", Theme.light()), ("dark", Theme.dark())]
+    for ((name, theme) in themes) {
+        let gap = luminanceGap(theme.fieldActive, theme.field)
+        @Expect(gap >= 0.02)
+    }
+}
