+package cui.controls
+
+import lgui.{FrameInfo, Key, Rect, Renderer, UiEvent}
+import cui.core.{Button, State, StateStore, Theme, UiContext, buildRoot}
+
+private func overlayFocusTestContext(): UiContext {
+    let ctx = UiContext(Renderer.headless(), Theme.light())
+    ctx.viewportWidth = 400.0
+    ctx.viewportHeight = 300.0
+    ctx
+}
+
+// Modal 打开时聚焦第一个停靠点（viaKeyboard，开弹窗即待键入/Tab）。
+@Test
+func modalOpenFocusesFirstStop(): Unit {
+    let ctx = overlayFocusTestContext()
+    let open = State<Bool>(true)
+    let store = StateStore()
+    let modal = buildRoot({=> Modal(open) {
+        Button("甲", {=> ()}).key("m.a")
+        Button("乙", {=> ()}).key("m.b")
+    } }, store)
+    ctx.frame = FrameInfo(UInt64(0), UInt64(0))
+    modal.layout(ctx, Rect.zero())
+    @Expect(ctx.hasFocus("m.a")) // 首个停靠点
+    @Expect(ctx.showFocusRing("m.a")) // 键盘意图：外环可见
+    @Expect(!ctx.hasFocus("m.b"))
+}
+
+// Modal 关闭后恢复打开前的焦点。
+@Test
+func modalDismissRestoresPriorFocus(): Unit {
+    let ctx = overlayFocusTestContext()
+    ctx.focus("outside.field") // 打开前的窗口焦点
+    let open = State<Bool>(true)
+    let store = StateStore()
+    let modal = buildRoot({=> Modal(open) {
+        Button("好", {=> ()}).key("r.ok")
+    } }, store)
+    ctx.frame = FrameInfo(UInt64(0), UInt64(0))
+    modal.layout(ctx, Rect.zero())
+    modal.draw(ctx)
+    @Expect(ctx.hasFocus("r.ok")) // 打开即聚焦弹窗内容
+
+    // Escape 经 overlay 路由（模态吞掉一切事件）。
+    @Expect(ctx.dispatchOverlay(UiEvent.KeyDown(Key.Escape, false)))
+    @Expect(!open.value)
+    ctx.frame = FrameInfo(UInt64(400), UInt64(400))
+    modal.layout(ctx, Rect.zero()) // 关闭过渡推进
+    ctx.frame = FrameInfo(UInt64(900), UInt64(500))
+    modal.layout(ctx, Rect.zero()) // 关闭完成后恢复
+    @Expect(ctx.hasFocus("outside.field"))
+}
