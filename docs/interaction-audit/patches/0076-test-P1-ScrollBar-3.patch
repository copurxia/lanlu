@@ -0,0 +1,58 @@
+package cui.core
+
+import lgui.{MouseButton, Rect, UiEvent}
+
+/*
+ * ScrollBar 此前无直接测试——但它是所有滚动容器共用的滑块/轨道/拖动几何实现
+ * （press 抓取、轨道翻页、drag 映射）。容器级测试覆盖了"能滚"，这里验证几何契约本身。
+ */
+@Test
+func scrollBarPressGrabsThumbAndDragTracksPointer(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let bar = ScrollBar("test.bar.grab")
+    let frame = Rect(0.0, 0.0, 200.0, 100.0) // 视口 100，内容 400 → 滑块约 1/4 高
+    let contentH: Float32 = 400.0
+    let viewportH: Float32 = 100.0
+
+    // 滑块在顶部附近；按在滑块上 → 抓取成功，右边界不跳变。
+    @Expect(bar.press(ctx, frame, offset, contentH, viewportH, 197.0, 5.0))
+    @Expect(bar.dragging(ctx))
+    @Expect(offset.value, Float32(0.0))
+
+    // 拖动到轨道中部：偏移随指针移动（与滑块几何一致，非零且被钳制）。
+    ctx.leftMouseDown = true
+    @Expect(bar.drag(ctx, frame, offset, contentH, viewportH, 50.0))
+    let dragged = offset.value
+    @Expect(dragged > 0.0)
+    @Expect(dragged <= contentH - viewportH)
+
+    // 拖到底部再往下：钳制在最大偏移，不越界。
+    let _ = bar.drag(ctx, frame, offset, contentH, viewportH, 500.0)
+    @Expect(offset.value <= contentH - viewportH)
+    ctx.leftMouseDown = false
+}
+
+@Test
+func scrollBarTrackClickPagesTowardPointer(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let bar = ScrollBar("test.bar.page")
+    let frame = Rect(0.0, 0.0, 200.0, 100.0)
+
+    // 点在滑块下方（轨道空白）→ 向后翻约 90% 视口。
+    @Expect(bar.press(ctx, frame, offset, 400.0, 100.0, 197.0, 90.0))
+    @Expect(offset.value > 0.0)
+    @Expect(offset.value <= 100.0) // 一页以内
+}
+
+@Test
+func scrollBarPressOutsideTrackIsNotClaimed(): Unit {
+    let ctx = testContext()
+    let offset = State<Float32>(0.0)
+    let bar = ScrollBar("test.bar.miss")
+    let frame = Rect(0.0, 0.0, 200.0, 100.0)
+    // 点在内容区左上（不在滚动条轨道上）。
+    @Expect(!bar.press(ctx, frame, offset, 400.0, 100.0, 20.0, 50.0))
+    @Expect(!bar.dragging(ctx))
+}
