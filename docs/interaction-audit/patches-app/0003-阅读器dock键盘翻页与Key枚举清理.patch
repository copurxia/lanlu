+    // 键盘翻页：以当前显示页为基准步进，夹在 1..total 之间。
+    private func seekPageBy(delta: Int64): Bool {
+        let total = model.reader.displayTotal
+        if (total <= 1) {
+            return false
+        }
+        model.noteReaderActivity()
+        model.gotoPage(max(1, min(total, model.reader.displayPage + 1 + delta)))
+        true
+    }
+
+    private func seekPageTo(page: Int64): Bool {
+        let total = model.reader.displayTotal
+        if (total <= 0) {
+            return false
+        }
+        model.noteReaderActivity()
+        model.gotoPage(max(1, min(total, page)))
+        true
+    }
